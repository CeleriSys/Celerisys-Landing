---
---

<nav class="nav-header">
  <a class="nlogo" href="#top">
    <img src="/svg/c.svg" alt="Celerisys" class="logo-icon">
    Celerisys
  </a>
  <button id="menu-toggle" class="menu-btn" aria-label="Abrir menú" aria-expanded="false" type="button">
    <span></span>
    <span></span>
  </button>
  <ul class="nlinks">
    <li><a href="#what">Qué hacemos</a></li>
    <li><a href="#results">Resultados</a></li>
    <li><a href="#method">Método</a></li>
    <li><a href="#booking">Contacto</a></li>
  </ul>
  <div class="nav-actions">
    <button id="theme-toggle" class="theme-btn" aria-label="Cambiar tema" type="button">
      <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
    <a href="#booking" class="ncta">Solicitar evaluación gratuita</a>
  </div>
</nav>

<style>
nav.nav-header {
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:100;
  height:70px;
  padding:0 40px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--nav-bg);
  backdrop-filter:blur(22px) saturate(160%);
  border-bottom:1px solid var(--border2);
  box-shadow:var(--nav-shadow);
  transform:none;
  animation:none;
  transition:background-color 0.3s ease, box-shadow .3s ease;
}

@keyframes navIn{to{transform:none}}

.nlogo {
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  color:var(--white);
  font-family:var(--font-h);
  font-weight:700;
  font-size:20px;
  transition: color 0.3s ease;
}

.logo-icon {
  width:30px;
  height:30px;
  filter: brightness(0) invert(1);
}

html.light .logo-icon {
  filter: brightness(1) invert(0);
}

.nlinks{
  display:flex;
  gap:clamp(14px,1.7vw,28px);
  list-style:none;
}

.nlinks a{
  font-size:14px;
  font-weight:500;
  color:var(--muted);
  text-decoration:none;
  transition:color .25s;
}

.nlinks a:hover{
  color:var(--white);
}

.nav-actions {
  display:flex;
  align-items:center;
  gap:16px;
}

.menu-btn {
  display:none;
  width:40px;
  height:40px;
  border:1px solid var(--border);
  border-radius:999px;
  background:rgba(255,255,255,.04);
  color:var(--white);
  cursor:pointer;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:6px;
  padding:0;
}

.menu-btn span {
  width:18px;
  height:2px;
  border-radius:999px;
  background:currentColor;
  transition:transform .25s ease;
}

.nav-header.open .menu-btn span:first-child {
  transform:translateY(4px) rotate(45deg);
}

.nav-header.open .menu-btn span:last-child {
  transform:translateY(-4px) rotate(-45deg);
}

.theme-btn {
  width:40px;
  height:40px;
  border:1px solid var(--border);
  border-radius:999px;
  background:transparent;
  color:var(--white);
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all 0.3s ease;
  padding:0;
}

.theme-btn:hover {
  background:rgba(255,255,255,.07);
  border-color:rgba(255,255,255,.2);
}

.theme-btn:active,
.menu-btn:active,
.ncta:active {
  transform:scale(.96);
  transition-duration:100ms;
}

.theme-btn svg {
  width:18px;
  height:18px;
}

.sun-icon {
  display:block;
}

.moon-icon {
  display:none;
}

html.light .sun-icon {
  display:none;
}

html.light .moon-icon {
  display:block;
}

.ncta{
  padding:10px 20px;
  background:var(--button-bg);
  border:1px solid var(--button-bg);
  border-radius:999px;
  font-family:var(--font-h);
  font-size:13px;
  font-weight:600;
  color:var(--button-text);
  cursor:pointer;
  text-decoration:none;
  transition:background-color .18s ease,border-color .18s ease;
}

.ncta:hover{
  transform:none;
  filter:brightness(.92);
}

html.light .theme-btn:hover,
html.light .menu-btn:hover {
  background:rgba(17,17,20,.06);
  border-color:rgba(17,17,20,.18);
}

@media(prefers-reduced-transparency:reduce) {
  nav.nav-header { background:var(--surface);backdrop-filter:none; }
}

@media(max-width:1120px) {
  nav.nav-header {
    height:64px;
    padding:0 16px;
  }

  .nlogo {
    font-size:18px;
    min-width:0;
  }

  .logo-icon {
    width:28px;
    height:28px;
  }

  .menu-btn {
    display:flex;
    order:3;
    margin-left:14px;
  }

  .nav-actions {
    margin-left:auto;
    gap:10px;
    order:2;
  }

  .ncta {
    display:none;
  }

  .nlinks {
    position:absolute;
    top:calc(100% + 10px);
    left:16px;
    right:16px;
    display:grid;
    gap:6px;
    padding:12px;
    border:1px solid var(--border);
    border-radius:12px;
    background:var(--nav-bg);
    box-shadow:0 18px 44px rgba(0,0,0,.22), 0 0 28px rgba(14,90,156,.12);
    backdrop-filter:blur(20px);
    transform:translateY(-10px);
    opacity:0;
    pointer-events:none;
    transition:opacity .22s ease, transform .22s ease;
  }

  .nav-header.open .nlinks {
    transform:none;
    opacity:1;
    pointer-events:auto;
  }

  .nlinks a {
    display:flex;
    min-height:42px;
    align-items:center;
    padding:0 12px;
    border-radius:8px;
    color:var(--white);
    background:rgba(14,90,156,.06);
  }

  .nlinks a:hover {
    background:rgba(14,90,156,.12);
  }
}

@media(max-width:390px) {
  .nlogo {
    font-size:16px;
    gap:8px;
  }

  .theme-btn,
  .menu-btn {
    width:38px;
    height:38px;
  }

  .menu-btn {
    margin-left:10px;
  }
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const themeToggle = document.getElementById('theme-toggle');
  const menuToggle = document.getElementById('menu-toggle');
  const nav = document.querySelector('.nav-header');

  if (themeToggle) {
    themeToggle.addEventListener('click', function() {
      const html = document.documentElement;
      const isLight = html.classList.contains('light');

      if (isLight) {
        html.classList.remove('light');
        localStorage.setItem('theme', 'dark');
      } else {
        html.classList.add('light');
        localStorage.setItem('theme', 'light');
      }
    });
  }

  if (menuToggle && nav) {
    menuToggle.addEventListener('click', function() {
      const isOpen = nav.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    });

    nav.querySelectorAll('.nlinks a').forEach(function(link) {
      link.addEventListener('click', function() {
        nav.classList.remove('open');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      });
    });
  }
});
</script>

