---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
---

<Layout title="Página no encontrada — Celerisys" noindex={true}>
  <Container class="min-h-screen flex items-center justify-center text-center py-20">
    <div class="max-w-xl animate-on-scroll">
      <h1 class="text-6xl font-bold text-secondary-900 dark:text-white mb-8">404</h1>
      <p class="text-2xl font-semibold text-secondary-900 dark:text-white mb-4">Página no encontrada</p>
      <p class="text-secondary-600 dark:text-secondary-400 mb-8">
        La página que buscas no existe o fue movida.
      </p>
      <Button href="/" size="lg">
        Volver al inicio
      </Button>
    </div>
  </Container>
</Layout>
