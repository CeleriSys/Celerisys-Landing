</style>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const contactButton = contactForm?.querySelector('.contact-submit');
  const contactStatus = contactForm?.querySelector('.contact-status');
  const prioritySelect = contactForm?.querySelector('[name="interest"]');
  const priorityShell = prioritySelect?.closest('.select-shell');
  const messageField = contactForm?.querySelector('[name="message"]');
  const messageCount = document.getElementById('message-count');
  const formStartedAt = document.getElementById('form-started-at');

  const resetStartedAt = () => {
    if (formStartedAt instanceof HTMLInputElement) formStartedAt.value = String(Date.now());
  };

  const updateMessageCount = () => {
    if (messageField instanceof HTMLTextAreaElement && messageCount) {
      messageCount.textContent = `${messageField.value.length}/2000`;
    }
  };

  const validationMessage = (field) => {
    const value = field.value.trim();
    if (field.required && !value) return 'Completa este campo para continuar.';
    if (field.name === 'name' && value.length < 2) return 'Escribe al menos 2 caracteres.';
    if (field.name === 'email' && field.validity.typeMismatch) return 'Ingresa un correo válido, por ejemplo nombre@empresa.com.';
    if (field.name === 'phone' && value && !/^[+0-9() .-]{7,24}$/.test(value)) return 'Usa un número válido, por ejemplo +51 999 999 999.';
    if (field.name === 'message' && value.length < 20) return 'Cuéntanos un poco más: usa al menos 20 caracteres.';
    return '';
  };

  const validateField = (field) => {
    if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) return true;
    const message = validationMessage(field);
    field.setAttribute('aria-invalid', message ? 'true' : 'false');
    const errorId = field.getAttribute('aria-describedby')?.split(' ')[0];
    const error = errorId ? document.getElementById(errorId) : null;
    if (error?.classList.contains('field-error')) error.textContent = message;
    return !message;
  };

  const updatePriorityStyle = () => {
    if (prioritySelect instanceof HTMLSelectElement) {
      priorityShell?.classList.toggle('has-value', Boolean(prioritySelect.value));
    }
  };

  prioritySelect?.addEventListener('change', updatePriorityStyle);
  messageField?.addEventListener('input', updateMessageCount);
  updatePriorityStyle();
  updateMessageCount();
  resetStartedAt();

  if (contactForm) {
    const query = new URLSearchParams(window.location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((name) => {
      const field = contactForm.querySelector(`[name="${name}"]`);
      if (field instanceof HTMLInputElement) field.value = query.get(name) || '';
    });
    const landingPage = document.getElementById('landing-page-field');
    if (landingPage instanceof HTMLInputElement) landingPage.value = window.location.href;

    contactForm.querySelectorAll('.contact-field input, .contact-field textarea').forEach((field) => {
      field.addEventListener('blur', () => validateField(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validateField(field);
      });
    });
  }

  document.querySelectorAll('[data-conversion]').forEach((link) => {
    link.addEventListener('click', () => {
      if (!(link instanceof HTMLElement)) return;
      window.dispatchEvent(new CustomEvent('celerisys:conversion', {
        detail: { action: link.dataset.conversion }
      }));
    });
  });

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const fields = [...contactForm.querySelectorAll('.contact-field input, .contact-field textarea')];
    const validationResults = fields.map((field) => ({ field, valid: validateField(field) }));
    const invalidField = validationResults.find((result) => !result.valid)?.field;
    if (invalidField instanceof HTMLElement) {
      invalidField.focus();
      return;
    }

    const endpoint = contactForm.dataset.endpoint;
    if (!endpoint) {
      if (contactStatus instanceof HTMLElement) {
        contactStatus.dataset.state = 'error';
        contactStatus.textContent = 'El formulario todavía no está conectado. Por favor, escríbenos por WhatsApp.';
      }
      return;
    }

    const senderName = contactForm.querySelector('[name="name"]')?.value.trim() || '';
    if (contactButton instanceof HTMLButtonElement) {
      contactButton.disabled = true;
      contactButton.textContent = 'Enviando…';
    }
    if (contactStatus instanceof HTMLElement) contactStatus.textContent = '';
    window.dispatchEvent(new CustomEvent('celerisys:conversion', {
      detail: { action: 'contact-form-submit' }
    }));

    try {
      await fetch(endpoint, {
        method: 'POST',
        body: new FormData(contactForm),
        mode: 'no-cors'
      });
      contactForm.reset();
      updatePriorityStyle();
      updateMessageCount();
      resetStartedAt();
      fields.forEach((field) => {
        field.setAttribute('aria-invalid', 'false');
        const errorId = field.getAttribute('aria-describedby')?.split(' ')[0];
        const error = errorId ? document.getElementById(errorId) : null;
        if (error?.classList.contains('field-error')) error.textContent = '';
      });
      if (contactStatus instanceof HTMLElement) {
        contactStatus.dataset.state = 'success';
        contactStatus.textContent = `Gracias${senderName ? `, ${senderName}` : ''}. Recibimos tu solicitud y también te enviamos una confirmación por correo.`;
      }
      window.dispatchEvent(new CustomEvent('celerisys:conversion', {
        detail: { action: 'contact-form-success' }
      }));
    } catch {
      if (contactStatus instanceof HTMLElement) {
        contactStatus.dataset.state = 'error';
        contactStatus.textContent = 'No pudimos enviar tu solicitud. Inténtalo nuevamente o escríbenos por WhatsApp.';
      }
    } finally {
      if (contactButton instanceof HTMLButtonElement) {
        contactButton.disabled = false;
        contactButton.textContent = 'Solicitar evaluación gratuita';
      }
    }
  });
</script>
