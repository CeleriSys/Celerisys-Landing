---
const year = new Date().getFullYear();
---

<footer class="footer-new">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="nlogo" href="#top">
        <img src="/svg/c.svg" alt="Celerisys" class="logo-icon">
        Celerisys
      </a>
      <p>Software a medida y automatización para que tu operación avance sin depender de tareas manuales.</p>
    </div>

    <nav class="footer-nav" aria-label="Navegación del pie de página">
      <a href="#what">Servicios</a>
      <a href="#method">Método</a>
      <a href="#results">Resultados</a>
      <a href="#booking">Agendar cita</a>
    </nav>

    <div class="footer-cta">
      <span>Arequipa, Perú</span>
      <a class="footer-button" href="#booking">Hablar con el equipo</a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} Celerisys. Todos los derechos reservados.</span>
    <span>Software que trabaja mientras tú descansas.</span>
  </div>
</footer>

<style>
.footer-new {
  position:relative;
  z-index:1;
  border-top:1px solid var(--border2);
  background:
    radial-gradient(ellipse 70% 90% at 50% 0%, rgba(14,90,156,.1), transparent 65%),
    rgba(5,7,18,.42);
  padding:56px 40px 28px;
}

.footer-inner {
  max-width:1180px;
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(240px, 1.4fr) minmax(160px, .8fr) minmax(210px, .8fr);
  gap:36px;
  align-items:start;
}

.footer-brand {
  max-width:420px;
}

.nlogo {
  display:inline-flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  font-family:var(--font-h);
  font-weight:700;
  font-size:20px;
  color:var(--white);
}

.logo-icon {
  width:28px;
  height:28px;
  flex:0 0 auto;
  filter:drop-shadow(0 0 16px rgba(14,90,156,.45));
}

.footer-brand p {
  margin-top:14px;
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
}

.footer-nav {
  display:grid;
  gap:12px;
}

.footer-nav a,
.footer-cta span {
  color:var(--muted);
  font-size:13px;
  line-height:1.4;
}

.footer-nav a {
  text-decoration:none;
  transition:color .2s, transform .2s;
}

.footer-nav a:hover {
  color:var(--blue-light);
  transform:translateX(3px);
}

.footer-cta {
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:14px;
}

.footer-button {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:40px;
  padding:0 18px;
  border-radius:8px;
  background:linear-gradient(135deg,#0E5A9C,#083B6F);
  color:#fff;
  font-family:var(--font-h);
  font-size:13px;
  font-weight:600;
  text-decoration:none;
  box-shadow:0 10px 28px rgba(14,90,156,.28);
  transition:transform .2s, box-shadow .2s;
}

.footer-button:hover {
  transform:translateY(-2px);
  box-shadow:0 14px 34px rgba(14,90,156,.38);
}

.footer-bottom {
  max-width:1180px;
  margin:36px auto 0;
  padding-top:22px;
  border-top:1px solid var(--border2);
  display:flex;
  justify-content:space-between;
  gap:16px;
  color:var(--muted);
  font-size:12px;
}

html.light .footer-new {
  background:
    radial-gradient(ellipse 70% 90% at 50% 0%, rgba(14,90,156,.07), transparent 65%),
    rgba(255,255,255,.72);
}

@media(max-width:820px) {
  .footer-new {
    padding:44px 24px 24px;
  }

  .footer-inner {
    grid-template-columns:1fr;
    gap:30px;
  }

  .footer-nav {
    grid-template-columns:repeat(2, minmax(0, 1fr));
  }

  .footer-bottom {
    flex-direction:column;
  }
}

@media(max-width:480px) {
  .footer-nav {
    grid-template-columns:1fr;
  }
}
</style>
