---
const plans = [
  { name: 'Base', tag: 'Tu primera web profesional', price: 'US$ 229', description: 'Para presentar tu negocio y recibir consultas.', time: '7–10 días hábiles', cta: 'Quiero el plan Base' },
  { name: 'Plus', tag: 'Más espacio para crecer', price: 'US$ 429', description: 'Para empresas que necesitan mostrar sus servicios y medir sus consultas.', time: '15–20 días hábiles', cta: 'Quiero el plan Plus' },
  { name: 'Pro', tag: 'Una presencia más completa', price: 'US$ 699', description: 'Para negocios con más servicios y contenido que mostrar.', time: '20–25 días hábiles', cta: 'Quiero el plan Pro' },
];
const contentHelp = { label: '¿Qué incluye la carga de contenido?', items: [
  { title: 'Contenido del cliente', text: 'Tú entregas los textos e imágenes; nosotros los organizamos y publicamos. Elige artículos o catálogo informativo. No incluye redacción, cargas mensuales ni panel para editar.' },
] };
const helpContent: Record<string, { label: string; items: { title: string; text: string }[] }> = {
  'Carga de 10 artículos o productos': contentHelp,
  'Carga de 20 artículos o productos': contentHelp,
  'SEO y GEO inicial': { label: '¿Qué son SEO y GEO?', items: [
    { title: 'SEO', text: 'Preparamos tu web para que los buscadores como Google puedan entenderla y encontrarla.' },
    { title: 'GEO', text: 'Organizamos la información para facilitar que buscadores con IA la interpreten y puedan usarla como referencia.' },
  ] },
  'Analytics y Search Console': { label: '¿Qué son Analytics y Search Console?', items: [
    { title: 'Google Analytics', text: 'Configuramos la herramienta para conocer cuántas personas visitan tu web y qué páginas consultan.' },
    { title: 'Search Console', text: 'Conectamos tu web con Google para consultar cómo aparece en sus búsquedas y detectar problemas de indexación. Incluye la configuración inicial, no informes ni seguimiento mensual.' },
  ] },
};
const comparison = (name: string) => {
  const index = ['Base', 'Plus', 'Pro'].indexOf(name);
  return [
    { text: ['Una página con hasta 6 secciones', 'Hasta 5 páginas adaptadas a tu marca', 'Hasta 8 páginas adaptadas a tu marca'][index], included: true },
    { text: 'Adaptada a celulares y con conexión segura', included: true },
    { text: 'SEO y GEO inicial', included: true },
    { text: index === 0 ? 'Formulario y WhatsApp' : 'Hasta 3 formularios y WhatsApp', included: true },
    { text: 'Analytics y Search Console', included: index > 0 },
    { text: ['Artículos o catálogo de productos', 'Carga de 10 artículos o productos', 'Carga de 20 artículos o productos'][index], included: index > 0 },
    { text: 'Registro de consultas y clics en WhatsApp', included: index === 2 },
    { text: 'Te enseñamos a usar tu web', included: index === 2 },
    { text: ['2 rondas de ajustes', '3 rondas de ajustes', '3 rondas de ajustes'][index], included: true },
    { text: ['Corrección de errores por 15 días', 'Corrección de errores por 30 días', 'Corrección de errores por 45 días'][index], included: true },
  ];
};
---
<section id="planes" aria-labelledby="plans-title">
  <div class="inner">
    <div class="plans-heading">
      <div class="section-title-group"><span class="slabel">Planes web</span>
      <h2 id="plans-title" class="stitle">Una web para cada etapa.</h2></div>
      <p class="sbody">Elige tu plan. Acordamos qué incluye antes de empezar.</p>
    </div>
    <div class="plans-grid">
      {plans.map((plan) => (
        <article class:list={['plan-card', { 'plan-featured': plan.name === 'Plus' }]}>
          <div class="plan-top"><span>{plan.tag}</span>{plan.name === 'Plus' && <span class="plan-badge">Recomendado</span>}</div>
          <h3>Plan {plan.name}</h3>
          <p class="plan-description">{plan.description}</p>
          <div class="plan-price"><span>Precio del plan</span><strong>{plan.price}</strong><span>Pago único por desarrollo</span></div>
          <ul>{comparison(plan.name).map((feature, index) => (
            <li class:list={{ 'feature-excluded': !feature.included }}>
              <span aria-hidden="true">{feature.included ? '✓' : '×'}</span>
              <span class="feature-label">
                <span class="feature-status">{feature.included ? 'Incluido: ' : 'No incluido: '}</span>{feature.text}
                {helpContent[feature.text] && <span class="plan-help">
                  <button type="button" class="plan-help-button" aria-label={helpContent[feature.text].label} aria-expanded="false" aria-describedby={`plan-help-${plan.name}-${index}`}>?</button>
                  <span class="plan-help-text" role="tooltip" id={`plan-help-${plan.name}-${index}`}>
                    {helpContent[feature.text].items.map(item => <><strong>{item.title}</strong><span>{item.text}</span></>)}
                  </span>
                </span>}
              </span>
            </li>
          ))}</ul>
          <p class="plan-time">Entrega estimada: {plan.time}</p>
          <a class="plan-cta" href={`https://wa.me/51935875743?text=${encodeURIComponent(`Hola, me interesa el plan ${plan.name} de Celerisys. Quisiera recibir una propuesta para mi web.`)}`} target="_blank" rel="noopener noreferrer" data-conversion={`whatsapp-plan-${plan.name.toLowerCase()}`}>{plan.cta}<span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
    <div class="custom-project">
      <p><strong>¿Necesitas algo personalizado?</strong><span>¿Una tienda o conectar tus herramientas? Conversemos.</span></p>
      <a href="#booking">Agendar reunión <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<style>
  #planes { background:linear-gradient(145deg,var(--surface),var(--surface2) 145%); }
  .plans-heading { max-width:720px;margin-bottom:40px; }
  .plans-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px; }
  .plan-card { display:flex;flex-direction:column;min-width:0;padding:28px;border:1px solid var(--border2);border-radius:18px;background:var(--card);box-shadow:var(--page-shadow); }
  .plan-featured { border-color:var(--blue);background:linear-gradient(150deg,var(--card-elevated),var(--card)); }
  .plan-top { display:flex;flex-wrap:wrap;align-items:center;gap:8px;min-height:48px;color:var(--muted);font-size:11px; }
  .plan-badge { border:1px solid var(--border);border-radius:999px;padding:4px 9px;color:var(--blue-light); }
  h3 { margin:18px 0 12px;font-family:var(--font-h);font-size:28px;line-height:1.15;letter-spacing:-.025em; }
  .plan-description { min-height:68px;color:var(--muted);font-size:14px;line-height:1.6; }
  .plan-price { display:flex;flex-direction:column;gap:6px;padding:26px 0;border-bottom:1px solid var(--border2); }
  .plan-price span { color:var(--muted);font-size:12px; }
  .plan-price strong { font-family:var(--font-h);font-size:40px;line-height:1.2;letter-spacing:-.04em; }
  ul { display:grid;gap:13px;list-style:none;padding:24px 0;margin:0; }
  li { display:flex;gap:10px;font-size:13px;line-height:1.5; }
  li>span { color:var(--blue-light);flex-shrink:0; }
  .plan-time { margin-top:auto;padding-top:12px;color:var(--muted);font-size:11px;line-height:1.5; }
  .plan-cta { display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;margin-top:20px;padding:12px 16px;border:1px solid var(--border);border-radius:12px;color:var(--white);font-family:var(--font-h);font-size:14px;font-weight:600;text-decoration:none; }
  .plan-featured .plan-cta { background:var(--button-bg);border-color:var(--button-bg);color:var(--button-text); }
  .plan-cta:hover { border-color:var(--blue); }
  .plan-cta:focus-visible { outline:3px solid var(--blue);outline-offset:4px; }
  @media(max-width:760px) { .plans-grid { grid-template-columns:1fr; }.plans-heading { display:block; }.plans-heading .sbody { margin-top:10px; }.plan-description { min-height:0; }.plan-top { min-height:0; } }
  #planes .inner { padding-top:32px;padding-bottom:32px; }
  .plans-heading { max-width:none;display:grid;grid-template-columns:1fr 1fr;column-gap:32px;align-items:end;margin-bottom:22px; }
  .plans-heading .section-title-group { min-width:0; }
  .plans-heading .stitle { font-size:var(--section-title-size); }
  .plans-heading .sbody { margin-top:0;font-size:14px;line-height:1.5; }
  .plans-grid { gap:16px; }
  .plan-card { padding:20px; }
  .plan-top { min-height:28px;font-size:10px;gap:6px; }
  .plan-badge { padding:3px 7px; }
  h3 { margin:12px 0 8px;font-size:25px; }
  .plan-description { min-height:42px;font-size:12px;line-height:1.5; }
  .plan-price { padding:14px 0;gap:3px; }
  .plan-price strong { font-size:34px; }
  .plan-price span { font-size:11px; }
  ul { gap:8px;padding:16px 0; }
  li { font-size:12px;line-height:1.45;gap:8px; }
  .plan-time { padding-top:6px; }
  .plan-cta { min-height:42px;margin-top:12px;padding:10px 12px;font-size:13px; }
  @media(max-width:760px) { .plans-heading { display:block; }.plans-heading .sbody { margin-top:10px; }.plan-description { min-height:0; } }
  .custom-project { display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:18px;padding-top:16px;border-top:1px solid var(--border); }
  .custom-project p { display:flex;flex-wrap:wrap;gap:6px 12px;font-size:12px;line-height:1.5; }
  .custom-project p>span { color:var(--muted); }
  .custom-project a { flex-shrink:0;color:var(--blue-light);font-size:13px;font-weight:600;text-decoration:underline;text-underline-offset:4px; }
  @media(max-width:760px) { .custom-project { align-items:flex-start;flex-direction:column;gap:12px; } }
  li { min-height:18px;align-items:flex-start; }
  li>.feature-label { color:inherit;flex-shrink:1; }
  li.feature-excluded,li.feature-excluded>span { color:#f28b91; }
  :global(html.light) li.feature-excluded,:global(html.light) li.feature-excluded>span { color:#b93845; }
  .feature-status { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap; }
  .plan-help { position:relative;display:inline-flex;vertical-align:middle;margin-left:6px; }
  .plan-help-button { display:grid;place-items:center;width:17px;height:17px;padding:0;border:1px solid var(--border);border-radius:50%;background:transparent;color:var(--blue-light);font:600 10px var(--font-b);cursor:help; }
  .plan-help-button:focus-visible { outline:2px solid var(--blue);outline-offset:3px; }
  .plan-help-text { position:absolute;z-index:20;left:-100px;bottom:100%;width:240px;max-width:70vw;padding:14px;border:1px solid var(--border);border-radius:12px;background:var(--surface2);color:var(--white);box-shadow:0 8px 28px rgba(0,0,0,.18);font-size:12px;line-height:1.55;visibility:hidden;opacity:0;pointer-events:none; }
  .plan-help-text strong { display:block;color:var(--blue-light);font-size:11px;margin-bottom:4px; }
  .plan-help-text>span { display:block; }
  .plan-help-text strong:not(:first-child) { margin-top:10px; }
  .plan-help:hover .plan-help-text,.plan-help:focus-within .plan-help-text,.plan-help:has([aria-expanded="true"]) .plan-help-text { visibility:visible;opacity:1;pointer-events:auto; }
  .plan-help[data-dismissed] .plan-help-text { visibility:hidden;opacity:0;pointer-events:none; }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.plan-help-button').forEach(button => {
    const wrapper = button.closest<HTMLElement>('.plan-help')!;
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      wrapper.toggleAttribute('data-dismissed', !open);
    });
    wrapper.addEventListener('mouseenter', () => wrapper.removeAttribute('data-dismissed'));
    button.addEventListener('focus', () => wrapper.removeAttribute('data-dismissed'));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') { button.setAttribute('aria-expanded', 'false');wrapper.setAttribute('data-dismissed', ''); }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !wrapper.contains(event.target)) { button.setAttribute('aria-expanded', 'false');wrapper.setAttribute('data-dismissed', ''); }
    });
  });
</script>
