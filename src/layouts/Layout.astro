---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Celerisys crea software a medida y automatiza procesos para que las empresas peruanas recuperen tiempo, reduzcan errores y puedan crecer.",
  image = "/og.png",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageURL = new URL(image, Astro.site ?? Astro.url.origin);
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Celerisys",
  url: "https://info.celerisys.com",
  logo: "https://info.celerisys.com/svg/c.svg",
  description: "Software a medida y automatización de procesos para empresas peruanas.",
  email: "celerisys@outlook.com",
  telephone: "+51935875743",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Arequipa",
    addressCountry: "PE",
  },
  sameAs: [
    "https://www.instagram.com/celerisys/",
    "https://www.tiktok.com/@celerisys",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/svg/c.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050506" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Celerisys" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Celerisys — automatización y software a medida" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=DM+Sans:wght@400;500;600;700&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0&display=swap" rel="stylesheet">
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script is:inline>
      // Initialize theme on page load
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'light') {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body id="top" class="flex flex-col min-h-screen transition-colors duration-300">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <a class="scroll-top" href="#top" aria-label="Subir al inicio" title="Subir al inicio">
      <span aria-hidden="true">↑</span>
    </a>
  </body>
</html>

<style is:global>
:root {
  --nav-height:70px;
  --blue: #6ca7ff;
  --blue2: #397bd8;
  --blue-light: #9bc5ff;
  --surface: #050506;
  --surface2: #101012;
  --glass: rgba(18,18,21,.78);
  --white: #f2f0f3;
  --muted: #96939b;
  --border: rgba(255,255,255,.14);
  --border2: rgba(255,255,255,.08);
  --green: #65d6a3;
  --font-h: 'Bricolage Grotesque', system-ui, sans-serif;
  --font-b: 'DM Sans', sans-serif;
  --ease: cubic-bezier(0.4,0,0.2,1);
  --nav-bg:rgba(27,29,34,.94);
  --nav-shadow:0 1px 0 rgba(255,255,255,.06),0 10px 32px rgba(0,0,0,.20);
  --text-primary: #ffffff;
  --text-secondary: rgba(255,255,255,0.65);
  --card:#111114;
  --card-elevated:#17171b;
  --button-bg:#f2f0f3;
  --button-text:#080809;
  --page-shadow:0 32px 80px rgba(0,0,0,.34);
  /* Breakpoints (max-width, mobile-first overrides): sm ≤639px, md ≤767px, lg ≤1023px, xl ≤1279px */
}

/* Modo claro */
html.light {
  --blue:#0967c2;
  --blue2:#074c91;
  --blue-light:#07599f;
  --surface:#f3f6fa;
  --surface2:#ffffff;
  --glass:rgba(255,255,255,.84);
  --white:#0b2135;
  --muted:#566879;
  --border:rgba(11,33,53,.17);
  --border2:rgba(11,33,53,.09);
  --green:#087a55;
  --nav-bg:rgba(226,231,237,.94);
  --nav-shadow:0 1px 0 rgba(11,33,53,.10),0 10px 30px rgba(11,33,53,.08);
  --text-primary:#0b2135;
  --text-secondary:#566879;
  --card:#ffffff;
  --card-elevated:#eef3f8;
  --button-bg:#0b2135;
  --button-text:#ffffff;
  --page-shadow:0 24px 60px rgba(11,33,53,.11);
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}

html{scroll-behavior:smooth;scroll-padding-top:var(--nav-height);}

body{
  background:var(--surface);
  color:var(--white);
  font-family:var(--font-b);
  overflow-x:hidden;
  transition:background-color .2s ease,color .2s ease;
  -webkit-font-smoothing:antialiased;
}

main {
  position:relative;
  z-index:1;
}

section{position:relative;overflow:hidden;}

@media(max-width:767px) {
  :root { --nav-height:64px; }
}

#particles {
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:0;
}

.inner{
  max-width:1180px;
  width:100%;
  margin:0 auto;
  padding-top:96px;
  padding-bottom:96px;
  padding-left:max(40px, env(safe-area-inset-left, 0px));
  padding-right:max(40px, env(safe-area-inset-right, 0px));
}

.slabel{
  display:inline-block;
  font-family:var(--font-h);
  font-size:11px;
  font-weight:600;
  letter-spacing:.15em;
  text-transform:uppercase;
  color:var(--blue);
  margin-bottom:14px;
}

.stitle{
  font-family:var(--font-h);
  font-size:clamp(28px,4vw,50px);
  font-weight:700;
  letter-spacing:-.025em;
  line-height:1.12;
  max-width:100%;
  overflow-wrap:anywhere;
}

.sbody{
  font-size:17px;
  line-height:1.72;
  color:var(--muted);
  max-width:540px;
  margin-top:14px;
}

.btn-p{
  display:inline-block;
  padding:13px 30px;
  background:linear-gradient(135deg,#0E5A9C,#083B6F);
  border:none;
  border-radius:8px;
  font-family:var(--font-h);
  font-size:14px;
  font-weight:600;
  color:#fff;
  cursor:pointer;
  text-decoration:none;
  transition:transform .2s,box-shadow .2s;
}

.btn-p:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 36px rgba(14,90,156,.48);
}

.btn-g{
  display:inline-block;
  padding:13px 30px;
  background:transparent;
  border:1px solid var(--border);
  border-radius:8px;
  font-family:var(--font-h);
  font-size:14px;
  font-weight:600;
  color:var(--blue-light);
  cursor:pointer;
  text-decoration:none;
  transition:all .25s;
}

.btn-g:hover{
  border-color:var(--blue);
  background:rgba(14,90,156,.09);
  color:#fff;
}

/* ── REVEAL ANIMATIONS ──────── */
.reveal{
  opacity:0;
  transition:opacity .7s var(--ease),transform .7s var(--ease);
}

.reveal.fl{transform:translateX(-56px);}
.reveal.fr{transform:translateX(56px);}
.reveal.fb{transform:translateY(46px);}
.reveal.vis{opacity:1;transform:none;}

.stg>*{
  opacity:0;
  transform:translateY(36px);
  transition:opacity .55s var(--ease),transform .55s var(--ease);
}

.stg.vis>*:nth-child(1){opacity:1;transform:none;transition-delay:0s}
.stg.vis>*:nth-child(2){opacity:1;transform:none;transition-delay:.08s}
.stg.vis>*:nth-child(3){opacity:1;transform:none;transition-delay:.16s}
.stg.vis>*:nth-child(4){opacity:1;transform:none;transition-delay:.24s}
.stg.vis>*:nth-child(5){opacity:1;transform:none;transition-delay:.32s}
.stg.vis>*:nth-child(6){opacity:1;transform:none;transition-delay:.40s}

::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-track{background:var(--surface);}
::-webkit-scrollbar-thumb{background:rgba(14,90,156,.38);border-radius:3px;}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}

/* ── INTRO ────────────────────────────────────── */
#intro {
  position:fixed;
  inset:0;
  z-index:9999;
  background:#000;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  animation:iFade .7s var(--ease) 4.2s forwards;
}

@keyframes iFade {
  to { opacity:0; pointer-events:none; }
}

#vc {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

#ilogo {
  position:relative;
  z-index:2;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:18px;
  width:min(86vw, 560px);
  text-align:center;
  animation:iIn 1s var(--ease) .4s both;
}

.intro-logo {
  width:clamp(74px, 18vw, 110px) !important;
  height:clamp(74px, 18vw, 110px) !important;
  border-radius:clamp(14px, 3vw, 20px) !important;
  filter:brightness(0) invert(1);
  object-fit:contain;
}

@keyframes iIn {
  from { opacity:0; transform:translateY(30px) }
  to { opacity:1; transform:none }
}

#iword {
  font-family:var(--font-h);
  font-size:clamp(36px,6vw,80px);
  font-weight:700;
  letter-spacing:-.03em;
  color:#fff;
  text-shadow:0 0 40px rgba(14,90,156,.9);
  animation:iWord 1s var(--ease) 1.3s both;
}

@keyframes iWord {
  from { opacity:0; letter-spacing:.08em }
  to { opacity:1; letter-spacing:-.03em }
}

#itag {
  font-family:var(--font-b);
  font-size:clamp(11px, 3.1vw, 15px);
  color:rgba(125,183,232,.72);
  letter-spacing:.11em;
  text-transform:uppercase;
  line-height:1.55;
  max-width:min(86vw, 560px);
  animation:iIn 1s var(--ease) 2.1s both;
}

/* ── HERO ────────────────────────────────────── */
#hero {
  min-height:100vh;
  min-height:100dvh;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  text-align:center;
  padding-top:120px;
  padding-bottom:80px;
  padding-left:max(40px, env(safe-area-inset-left, 0px));
  padding-right:max(40px, env(safe-area-inset-right, 0px));
  box-sizing:border-box;
  width:100%;
}

#hbg {
  position:absolute;
  inset:0;
  background:
    radial-gradient(ellipse 80% 55% at 50% 115%,rgba(14,90,156,.25) 0%,transparent 65%),
    radial-gradient(ellipse 100% 35% at 50% 100%,rgba(8,59,111,.16) 0%,transparent 60%),
    #061827;
}

html.light #hbg {
  background:
    radial-gradient(ellipse 80% 55% at 50% 115%,rgba(14,90,156,.1) 0%,transparent 65%),
    radial-gradient(ellipse 100% 35% at 50% 100%,rgba(14,90,156,.05) 0%,transparent 60%),
    #ffffff;
}

.mountain-bg {
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  pointer-events:none;
}

.hlabel {
  position:relative;
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:5px 15px;
  border:1px solid var(--border);
  border-radius:999px;
  font-family:var(--font-h);
  font-size:11px;
  font-weight:600;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--blue-light);
  margin-bottom:26px;
  background:rgba(14,90,156,.1);
  animation:iIn .8s var(--ease) 4.9s both;
}

.hlabel::before {
  content:'';
  width:5px;
  height:5px;
  border-radius:50%;
  background:var(--blue);
  box-shadow:0 0 7px var(--blue);
  animation:blink 2s infinite;
}

@keyframes blink {
  50% { opacity:.25 }
}

/* ── xl: compact desktop ─────────────────────── */
@media(max-width:1279px) {
  .inner {
    padding-top:88px;
    padding-bottom:88px;
    padding-left:max(32px, env(safe-area-inset-left, 0px));
    padding-right:max(32px, env(safe-area-inset-right, 0px));
  }

  #hero {
    padding-top:112px;
    padding-bottom:72px;
    padding-left:max(32px, env(safe-area-inset-left, 0px));
    padding-right:max(32px, env(safe-area-inset-right, 0px));
  }
}

/* ── lg: tablet landscape / small laptops ────── */
@media(max-width:1023px) {
  .inner {
    padding-top:80px;
    padding-bottom:80px;
    padding-left:max(28px, env(safe-area-inset-left, 0px));
    padding-right:max(28px, env(safe-area-inset-right, 0px));
  }

  #hero {
    padding-top:104px;
    padding-bottom:64px;
    padding-left:max(28px, env(safe-area-inset-left, 0px));
    padding-right:max(28px, env(safe-area-inset-right, 0px));
  }

  .mountain-bg svg {
    min-width:min(120vw, 1440px);
  }

  h1 {
    max-width:min(860px, 100%);
    padding:0 4px;
  }

  .pain-grid {
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:18px;
  }

  .res-grid {
    grid-template-columns:repeat(2, minmax(0, 1fr));
  }

  .steps {
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:20px 24px;
  }

  .steps::after {
    display:none;
  }

  .step {
    padding:20px 18px;
    background:rgba(14,90,156,.04);
    border:1px solid var(--border2);
    border-radius:14px;
  }
}

/* ── md: tablet portrait ─────────────────────── */
@media(max-width:767px) {
  .inner {
    padding-top:72px;
    padding-bottom:72px;
    padding-left:max(22px, env(safe-area-inset-left, 0px));
    padding-right:max(22px, env(safe-area-inset-right, 0px));
  }

  #hero {
    min-height:100svh;
    min-height:100dvh;
    padding-top:96px;
    padding-bottom:56px;
    padding-left:max(22px, env(safe-area-inset-left, 0px));
    padding-right:max(22px, env(safe-area-inset-right, 0px));
  }

  .mountain-bg svg {
    min-width:760px;
    transform:translateX(-14%);
  }

  .hlabel {
    max-width:100%;
    white-space:normal;
    justify-content:center;
    line-height:1.45;
    letter-spacing:.08em;
    text-align:center;
  }

  .hsub {
    font-size:17px;
    line-height:1.68;
    margin:20px 0 32px;
    max-width:min(540px, 100%);
    padding:0 2px;
  }

  .sbody {
    font-size:16px;
    max-width:100%;
  }

  .pain-grid {
    grid-template-columns:1fr;
    margin-top:40px;
    gap:16px;
  }

  .res-grid {
    grid-template-columns:1fr;
    margin-top:40px;
    border-radius:16px;
  }

  .steps {
    grid-template-columns:1fr;
    margin-top:40px;
  }

  .step {
    padding:24px 0;
    background:transparent;
    border:none;
    border-radius:0;
    border-bottom:1px solid var(--border2);
  }

  .step:last-child {
    border-bottom:none;
    padding-bottom:0;
  }

  .res-card {
    padding:32px 22px;
  }

  .res-num {
    font-size:clamp(36px, 10vw, 50px);
  }

  .book-wrap {
    gap:36px;
    margin-top:40px;
  }

  .calendly-inline-widget {
    height:680px !important;
  }
}

/* ── sm: phones ──────────────────────────────── */
@media(max-width:639px) {
  #hero {
    padding-top:92px;
    padding-bottom:48px;
    padding-left:max(18px, env(safe-area-inset-left, 0px));
    padding-right:max(18px, env(safe-area-inset-right, 0px));
  }

  .mountain-bg svg {
    min-width:760px;
    transform:translateX(-18%);
  }

  .hlabel {
    letter-spacing:.07em;
    padding:6px 14px;
  }

  .hsub {
    font-size:16px;
    line-height:1.65;
    margin:18px 0 28px;
  }

  .hact {
    width:100%;
    flex-direction:column;
    align-items:center;
    gap:12px;
  }

  .hact .btn-p,
  .hact .btn-g {
    width:100%;
    max-width:380px;
    text-align:center;
    box-sizing:border-box;
  }

  h1 {
    font-size:clamp(28px, 9.2vw, 52px);
    line-height:1.08;
  }
}

h1 {
  position:relative;
  font-family:var(--font-h);
  font-size:clamp(38px,6.5vw,90px);
  font-weight:700;
  line-height:1.04;
  letter-spacing:-.03em;
  max-width:860px;
  animation:iIn .9s var(--ease) 5.1s both;
}

.acc { color:var(--blue); }

.hsub {
  position:relative;
  max-width:540px;
  font-size:18px;
  line-height:1.72;
  color:var(--muted);
  margin:22px 0 38px;
  animation:iIn .9s var(--ease) 5.3s both;
}

.hact {
  position:relative;
  display:flex;
  gap:14px;
  flex-wrap:wrap;
  justify-content:center;
  animation:iIn .8s var(--ease) 5.5s both;
}

/* ── PAIN / HOOK ─────────────────────────────── */
#pain {
  background:rgba(14,90,156,.03);
}

html.light #pain {
  background:rgba(14,90,156,.02);
}

.pain-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  gap:20px;
  margin-top:56px;
  width:100%;
}

.pain-card {
  padding:28px 26px;
  background:var(--glass);
  border:1px solid var(--border2);
  border-radius:14px;
  backdrop-filter:blur(18px);
  transition:border-color .3s,transform .3s;
}

@media(hover:hover) and (pointer:fine) {
  .pain-card:hover {
    border-color:var(--blue);
    transform:translateY(-4px);
  }
}

@media(hover:none) {
  .pain-card:active {
    border-color:var(--blue);
  }
}

.pain-icon {
  font-size:26px;
  margin-bottom:14px;
}

.pain-q {
  font-family:var(--font-h);
  font-size:16px;
  font-weight:600;
  line-height:1.4;
  margin-bottom:10px;
}

.pain-a {
  font-size:13px;
  color:var(--muted);
  line-height:1.65;
}

/* ── WHAT WE DO ──────────────────────────────── */
#what .two {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:56px;
  align-items:center;
  margin-top:56px;
}

@media(max-width:1023px) {
  #what .two {
    grid-template-columns:1fr;
    gap:40px;
    margin-top:40px;
  }
}

.service-list {
  display:flex;
  flex-direction:column;
  gap:16px;
}

.svc {
  display:flex;
  align-items:flex-start;
  gap:14px;
  padding:22px 20px;
  background:var(--glass);
  border:1px solid var(--border2);
  border-radius:12px;
  backdrop-filter:blur(16px);
  transition:border-color .3s,transform .3s;
}

@media(hover:hover) and (pointer:fine) {
  .svc:hover {
    border-color:var(--blue);
    transform:translateX(4px);
  }
}

@media(hover:none) {
  .svc:active {
    border-color:var(--blue);
  }
}

.svc-ico {
  min-width:40px;
  height:40px;
  background:rgba(14,90,156,.14);
  border:1px solid rgba(14,90,156,.28);
  border-radius:9px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
}

html.light .svc-ico {
  background:rgba(14,90,156,.08);
  border:1px solid rgba(14,90,156,.15);
}

.svc-name {
  font-family:var(--font-h);
  font-size:15px;
  font-weight:600;
  margin-bottom:5px;
}

.svc-desc {
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}

/* ── RESULTS / NUMBERS ───────────────────────── */
#results {
  background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(14,90,156,.07),transparent 70%);
}

html.light #results {
  background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(14,90,156,.03),transparent 70%);
}

.res-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:2px;
  border:1px solid var(--border);
  border-radius:18px;
