---
import { homeFor, locales, localeFromPath } from '../i18n/translations';
const locale = localeFromPath(Astro.url.pathname);
const isPrivacy = Astro.url.pathname.replace(/\/$/, '').endsWith('/privacidad');
const names = { es: 'Español', en: 'English', pt: 'Português' };
---
<details class="language-picker">
  <summary aria-label="Language / Idioma"><span>{locale.toUpperCase()}</span><svg class="language-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary>
  <nav aria-label="Language / Idioma">
    {locales.map(lang => <a href={`${homeFor(lang)}${isPrivacy ? 'privacidad' : ''}`} lang={lang} hreflang={lang} aria-current={lang === locale ? 'page' : undefined} data-language={lang}>{names[lang]}</a>)}
  </nav>
</details>
<style>
  .language-picker { position:relative;font-size:12px; }
  summary { display:flex;align-items:center;justify-content:center;gap:7px;height:40px;min-width:58px;padding:0 12px;border:1px solid var(--border);border-radius:999px;list-style:none;cursor:pointer;color:var(--white);font-size:11px;font-weight:600;line-height:1; }
  .language-chevron { width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;opacity:.7;transition:transform .18s ease; }
  details[open] .language-chevron { transform:rotate(180deg); }
  summary::-webkit-details-marker { display:none; }
  nav { position:absolute;right:0;top:calc(100% + 8px);display:grid;min-width:148px;padding:6px;border:1px solid var(--border);border-radius:12px;background:var(--surface2);box-shadow:0 10px 28px rgba(0,0,0,.12); }
  a { color:var(--white);padding:10px 12px;border-radius:6px;text-decoration:none; }
  a:hover,a[aria-current] { background:var(--card-elevated);color:var(--blue-light); }
  summary:focus-visible,a:focus-visible { outline:2px solid var(--blue);outline-offset:3px; }
</style>
