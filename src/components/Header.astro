---
---

<nav class="nav-header">
  <a class="nlogo" href="/">
    <img src="/svg/c.svg" alt="Celerisys" class="logo-icon">
    Celerisys
  </a>
  <ul class="nlinks">
    <li><a href="#what">Qué hacemos</a></li>
    <li><a href="#method">Método</a></li>
    <li><a href="#testi">Clientes</a></li>
    <li><a href="#booking">Agendar</a></li>
  </ul>
  <div class="nav-actions">
    <button id="theme-toggle" class="theme-btn" aria-label="Cambiar tema" type="button">
      <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
    <a href="#booking" class="ncta">Agendar llamada gratuita</a>
  </div>
</nav>

<style>
nav.nav-header {
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:100;
  height:70px;
  padding:0 40px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--nav-bg);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border2);
  transform:translateY(-100%);
  animation:navIn .6s var(--ease) 4.6s forwards;
  transition:background-color 0.3s ease;
}

@keyframes navIn{to{transform:none}}

.nlogo {
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  color:var(--white);
  font-family:var(--font-h);
  font-weight:700;
  font-size:20px;
  transition: color 0.3s ease;
}

.logo-icon {
  width:30px;
  height:30px;
  filter: brightness(0) invert(1);
}

html.light .logo-icon {
  filter: brightness(1) invert(0);
}

.nlinks{
  display:flex;
  gap:32px;
  list-style:none;
}

.nlinks a{
  font-size:14px;
  font-weight:500;
  color:var(--muted);
  text-decoration:none;
  transition:color .25s;
}

.nlinks a:hover{
  color:var(--white);
}

.nav-actions {
  display:flex;
  align-items:center;
  gap:16px;
}

.theme-btn {
  width:40px;
  height:40px;
  border:1px solid var(--border);
  border-radius:8px;
  background:transparent;
  color:var(--white);
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all 0.3s ease;
  padding:0;
}

.theme-btn:hover {
  background:rgba(81,112,255,.1);
  border-color:var(--blue);
}

.theme-btn svg {
  width:18px;
  height:18px;
}

.sun-icon {
  display:block;
}

.moon-icon {
  display:none;
}

html.light .sun-icon {
  display:none;
}

html.light .moon-icon {
  display:block;
}

.ncta{
  padding:10px 22px;
  background:var(--blue);
  border:none;
  border-radius:8px;
  font-family:var(--font-h);
  font-size:13px;
  font-weight:600;
  color:#fff;
  cursor:pointer;
  text-decoration:none;
  transition:transform .2s,box-shadow .2s;
}

.ncta:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 28px rgba(81,112,255,.45);
}
</style>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const themeToggle = document.getElementById('theme-toggle');

  if (themeToggle) {
    themeToggle.addEventListener('click', function() {
      const html = document.documentElement;
      const isLight = html.classList.contains('light');

      if (isLight) {
        html.classList.remove('light');
        localStorage.setItem('theme', 'dark');
      } else {
        html.classList.add('light');
        localStorage.setItem('theme', 'light');
      }
    });
  }
});
</script>


