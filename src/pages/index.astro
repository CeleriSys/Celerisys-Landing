---
import Layout from '../layouts/Layout.astro';

const configuredContactEndpoint = import.meta.env.PUBLIC_GOOGLE_APPS_SCRIPT_URL ?? '';
const contactEndpoint = configuredContactEndpoint.startsWith('https://script.google.com/macros/s/')
  ? configuredContactEndpoint
  : '';
---

<Layout
  title="Celerisys — Automatización y software a medida en Perú"
  description="Automatizamos procesos y creamos software a medida para que empresas peruanas recuperen tiempo, reduzcan errores y crezcan con una operación más ordenada."
>
  <!-- ──────── HERO ──────── -->
  <section id="hero">
    <div id="hbg"></div>
    <div class="hero-layout">
      <div class="hero-copy">
        <div class="hlabel">Software a medida · Automatización · Arequipa, Perú</div>
        <h1>Webs, sistemas y automatizaciones para tu negocio.</h1>
        <p class="hsub">Diseñamos soluciones digitales claras para vender mejor, ordenar procesos y conectar tus herramientas.</p>
        <div class="hact">
          <a href="https://wa.me/51935875743?text=Hola%2C%20vi%20la%20web%20de%20Celerisys%20y%20quisiera%20evaluar%20qu%C3%A9%20procesos%20puedo%20automatizar%20en%20mi%20negocio." class="btn-g" target="_blank" rel="noopener noreferrer" data-conversion="whatsapp-hero">
            <svg class="hero-whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.57-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.894 9.888-9.894 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.9 6.989c-.002 5.45-4.437 9.893-9.892 9.893m8.413-18.297A11.815 11.815 0 0 0 12.055 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.689 1.448h.005c6.558 0 11.894-5.335 11.897-11.893a11.821 11.821 0 0 0-3.488-8.413Z" /></svg>
            Escribir por WhatsApp
          </a>
        </div>
        <div class="hero-assurance" aria-label="Ventajas del diagnóstico">
          <span>Evaluación inicial sin costo</span>
          <span>Respuesta en un día hábil</span>
          <span>Sin compromiso</span>
        </div>
      </div>
      <div class="hero-flow">
        <div class="flow-stage" role="img" aria-label="Proceso de trabajo de Celerisys: contacto, diagnóstico, propuesta, desarrollo y entrega.">
          <div class="flow-pattern" aria-hidden="true"></div>
          <svg class="flow-lines" viewBox="0 0 600 490" preserveAspectRatio="none" aria-hidden="true">
            <path class="flow-signal flow-signal-one" d="M138 113L177 149" />
            <path class="flow-signal flow-signal-two" d="M291 176L330 143" />
            <path class="flow-signal flow-signal-three" d="M395 145L368 288" />
            <path class="flow-signal flow-signal-four" d="M400 339L451 339" />
            <circle cx="138" cy="113" r="4" /><circle cx="177" cy="149" r="4" />
            <circle cx="291" cy="176" r="4" /><circle cx="330" cy="143" r="4" />
            <circle cx="395" cy="145" r="4" /><circle cx="368" cy="288" r="4" />
            <circle cx="400" cy="339" r="4" /><circle cx="451" cy="339" r="4" />
          </svg>
          <div class="flow-card flow-request"><span class="flow-index">01</span><span class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.5h7l3 3v14H7zM14 3.5v4h4M10 12h4M10 16h4" /></svg></span><strong>Contacto</strong><small>CUÉNTANOS TU RETO</small></div>
          <div class="flow-card flow-validation"><span class="flow-index">02</span><span class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m7 12 3 3 7-7M5 4h14v16H5z" /></svg></span><strong>Diagnóstico</strong><small>ENTENDEMOS TU PROCESO</small></div>
          <div class="flow-card flow-team"><span class="flow-index">03</span><span class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" /><path d="M5.5 19c.5-3 2.6-5 6.5-5s6 2 6.5 5M4 9.5h2M18 9.5h2" /></svg></span><strong>Propuesta</strong><small>DISEÑAMOS LA SOLUCIÓN</small></div>
          <div class="flow-card flow-system"><span class="flow-index">04</span><span class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="2" /><path d="M8 9h8M8 13h5M8 17h3" /></svg></span><strong>Desarrollo</strong><small>CONSTRUIMOS CONTIGO</small></div>
          <div class="flow-card flow-report"><span class="flow-index">05</span><span class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.5h7l3 3v14H7zM14 3.5v4h4M10 14l2 2 4-4" /></svg></span><strong>Entrega</strong><small>SOLUCIÓN FUNCIONANDO</small><span class="flow-outcome-mark" aria-hidden="true"></span></div>
          <div class="flow-caption"><span>DE TU PRIMER MENSAJE A UNA SOLUCIÓN FUNCIONANDO</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── WHAT WE DO ──────── -->
  <section id="what">
    <div class="inner">
      <div class="two">
        <div class="what-copy reveal fl">
          <span class="slabel">Qué hacemos</span>
          <h2 class="stitle">Creamos soluciones digitales claras, útiles y a medida.</h2>
          <p class="sbody">Entendemos tu problema, definimos la solución correcta y la llevamos a producción con diseño, desarrollo y acompañamiento.</p>
          <a href="#booking" class="btn-p" style="margin-top:28px;">Hablar con el equipo</a>
        </div>
        <div class="service-list stg reveal fr">
          <div class="svc">
            <div>
              <span class="svc-tag">01</span>
              <div class="svc-name">Automatización útil</div>
              <div class="svc-desc">Conectamos tareas repetitivas, formularios, WhatsApp, correos y reportes para ahorrar tiempo real.</div>
            </div>
          </div>
          <div class="svc">
            <div>
              <span class="svc-tag">02</span>
              <div class="svc-name">Sistemas a medida</div>
              <div class="svc-desc">Creamos herramientas internas para ordenar clientes, ventas, operaciones, permisos y seguimiento.</div>
            </div>
          </div>
          <div class="svc">
            <div>
              <span class="svc-tag">03</span>
              <div class="svc-name">Webs que convierten</div>
              <div class="svc-desc">Landing pages y sitios web con mensaje claro, carga rápida y llamados a la acción bien pensados.</div>
            </div>
          </div>
          <div class="svc">
            <div>
              <span class="svc-tag">04</span>
              <div class="svc-name">IA aplicada con criterio</div>
              <div class="svc-desc">Usamos IA cuando mejora atención, clasificación, análisis o productividad. No por moda.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── RESULTS ──────── -->
  <section id="results">
    <div class="inner">
      <div class="section-heading split-heading reveal fb">
        <div>
          <span class="slabel">Resultados</span>
          <h2 class="stitle">Menos tareas.<br>Más negocio.</h2>
        </div>
        <p class="sbody">Medimos el impacto en problemas concretos: menos reprocesos, respuestas más rápidas y mejor visibilidad para tomar decisiones.</p>
      </div>
      <div class="results-bento stg reveal fb">
        <article class="result-feature">
          <span class="result-kicker">Impacto observado</span>
          <div class="res-num">−70%</div>
          <div class="res-lbl">Menos tareas repetitivas</div>
          <div class="result-meter" aria-hidden="true"><span></span></div>
          <p>El equipo deja de copiar datos entre archivos, perseguir confirmaciones y corregir información duplicada. El resultado exacto depende de cada operación.</p>
        </article>
        <article class="res-card result-speed">
          <span class="result-kicker">Velocidad</span>
          <div class="res-num">3×</div>
          <div class="res-lbl">Respuesta operativa más rápida</div>
          <span class="result-note">Menos esperas entre áreas</span>
        </article>
        <article class="res-card result-businesses">
          <span class="result-kicker">Experiencia</span>
          <div class="res-num">+4</div>
          <div class="res-lbl">Negocios transformados</div>
          <span class="result-note">Soluciones ajustadas a cada negocio</span>
        </article>
        <article class="result-story reveal fb">
          <div class="story-mark">“</div>
          <p class="tquote">Celerisys encontró la fuga en nuestra operación. En pocas semanas empezamos a recuperar miles de soles que antes se escapaban sin darnos cuenta.</p>
          <div class="tauthor">
            <img class="tauthor-img" src="/delypapalogo-optimized.png" width="256" height="256" loading="lazy" alt="Logo de Delypapa">
            <div>
              <div class="tauthor-name">Delypapa</div>
              <div class="tauthor-role">Empresa de alimentos · Arequipa, Perú</div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ──────── METHOD ──────── -->
  <section id="method">
    <div class="inner">
      <div class="method-layout">
        <div class="method-intro reveal fl">
          <span class="slabel">Método</span>
          <h2 class="stitle">Antes de construir, hacemos que el problema sea visible.</h2>
          <p class="sbody">Trabajamos por etapas para entender el problema, priorizar bien y entregar una primera versión útil sin inflar el proyecto.</p>
        </div>
        <div class="method-path stg reveal fr">
          <article class="method-step">
            <div class="method-index">01</div>
            <div><span class="method-phase">ObservAR</span><h3>Entendemos cómo trabajas hoy</h3><p>Mapeamos tareas, responsables, archivos y puntos donde la información se corta.</p></div>
          </article>
          <article class="method-step">
            <div class="method-index">02</div>
            <div><span class="method-phase">Priorizar</span><h3>Elegimos el primer problema correcto</h3><p>Definimos qué conviene resolver primero para generar impacto sin frenar tu operación.</p></div>
          </article>
          <article class="method-step">
            <div class="method-index">03</div>
            <div><span class="method-phase">Validar</span><h3>Creamos y validamos contigo</h3><p>Desarrollamos por partes pequeñas para que puedas probar, corregir y aprobar con evidencia.</p></div>
          </article>
          <article class="method-step">
            <div class="method-index">04</div>
            <div><span class="method-phase">Adoptar</span><h3>Lo llevamos al trabajo real</h3><p>Implementamos, capacitamos y acompañamos los primeros usos para ajustar lo que haga falta.</p></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── FAQ ──────── -->
  <section id="faq">
    <div class="inner">
      <div class="faq-layout">
        <div class="faq-intro reveal fl">
          <span class="slabel">Preguntas frecuentes</span>
          <h2 class="stitle">Lo que necesitas saber antes de empezar.</h2>
          <p class="sbody">No necesitas llegar con una solución definida. Empezamos entendiendo el problema y te recomendamos el siguiente paso más conveniente.</p>
          <a href="#booking" class="btn-p">Cuéntanos tu caso</a>
        </div>
        <div class="faq-list reveal fr">
          <details>
            <summary>¿Cuánto cuesta desarrollar una solución?</summary>
            <p>Depende del proceso, las integraciones y el alcance. Después del diagnóstico inicial recibirás una propuesta clara por etapas, sin costos ocultos.</p>
          </details>
          <details>
            <summary>¿Cuánto tiempo demora?</summary>
            <p>Priorizamos una primera entrega útil y luego avanzamos por etapas. El plazo se define contigo después de mapear el proceso y sus riesgos.</p>
          </details>
          <details>
            <summary>¿Pueden trabajar con los sistemas que ya usamos?</summary>
            <p>Sí. Evaluamos tus herramientas actuales y, cuando es viable, las conectamos para evitar duplicar información o reemplazar todo de golpe.</p>
          </details>
          <details>
            <summary>¿Necesito saber exactamente qué software quiero?</summary>
            <p>No. Puedes empezar contándonos qué tarea consume tiempo, dónde ocurren errores o qué información hoy no puedes ver a tiempo.</p>
          </details>
          <details>
            <summary>¿Incluyen capacitación y soporte?</summary>
            <p>Sí. La puesta en marcha contempla acompañamiento y capacitación. El soporte posterior se define según las necesidades de cada solución.</p>
          </details>
          <details>
            <summary>¿Trabajan fuera de Arequipa?</summary>
            <p>Sí. Atendemos empresas de otras ciudades de Perú de forma remota y coordinamos cada etapa con seguimiento claro.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── BOOKING / CALENDAR ──────── -->
  <section id="booking">
    <div class="inner">
      <div class="book-wrap">
        <div class="book-left reveal fl">
          <span class="slabel">Contacto</span>
          <h2 class="stitle">Cuéntanos qué quieres mejorar.</h2>
          <p class="sbody">Explícanos brevemente tu operación y te responderemos con el siguiente paso más conveniente. Completarlo toma menos de dos minutos.</p>
          <div class="book-benefits">
            <div class="bben">Primera evaluación sin costo</div>
            <div class="bben">Respuesta personal, no automática</div>
            <div class="bben">Sin compromiso ni llamadas innecesarias</div>
          </div>
          <div class="book-meta-box">
            <div class="book-meta-label"><span class="material-symbols-rounded" aria-hidden="true">mail</span> Respuesta directa por correo</div>
            <div class="book-meta-text">Revisamos cada solicitud y normalmente respondemos dentro de un día hábil.</div>
          </div>
        </div>

        <div class="reveal fr">
          <form
            id="contact-form"
            class="contact-panel"
            action={contactEndpoint || undefined}
            data-endpoint={contactEndpoint}
            method="POST"
            novalidate
          >
            <input type="hidden" name="utm_source" value="">
            <input type="hidden" name="utm_medium" value="">
            <input type="hidden" name="utm_campaign" value="">
            <input type="hidden" name="utm_content" value="">
            <input type="hidden" name="landing_page" id="landing-page-field" value="">
            <input type="hidden" name="form_started_at" id="form-started-at" value="">
            <input class="contact-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="contact-form-head">
              <span>Hablemos de tu operación</span>
              <small>Todos los campos marcados son necesarios.</small>
            </div>

            <div class="contact-grid">
              <label class="contact-field">
                <span>Nombre *</span>
                <input type="text" name="name" autocomplete="name" placeholder="Tu nombre" minlength="2" maxlength="80" aria-describedby="name-error" required>
                <small class="field-error" id="name-error"></small>
              </label>
              <label class="contact-field">
                <span>Empresa (opcional)</span>
                <input type="text" name="company" autocomplete="organization" placeholder="Nombre de tu negocio" maxlength="100">
              </label>
              <label class="contact-field">
                <span>Correo *</span>
                <input type="email" name="email" autocomplete="email" placeholder="nombre@empresa.com" maxlength="160" aria-describedby="email-error" required>
                <small class="field-error" id="email-error"></small>
              </label>
              <label class="contact-field">
                <span>WhatsApp (opcional)</span>
                <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+51 999 999 999" maxlength="24" pattern="[+0-9() .-]{7,24}" aria-describedby="phone-error">
                <small class="field-error" id="phone-error"></small>
              </label>
              <label class="contact-field contact-field-wide">
                <span>¿Qué te gustaría mejorar? (opcional)</span>
                <span class="select-shell">
                  <span class="material-symbols-rounded select-leading" aria-hidden="true">tune</span>
                  <select name="interest" aria-label="Selecciona qué te gustaría mejorar">
                    <option value="" selected>Selecciona el principal reto de tu operación</option>
                    <option value="Automatizar tareas repetitivas">Automatizar tareas repetitivas</option>
                    <option value="Ordenar información y reportes">Ordenar información y reportes</option>
                    <option value="Crear software a medida">Crear software a medida</option>
                    <option value="Aplicar inteligencia artificial">Aplicar inteligencia artificial</option>
                    <option value="Aún no estoy seguro">Aún no estoy seguro</option>
                  </select>
                  <span class="material-symbols-rounded select-chevron" aria-hidden="true">expand_more</span>
                </span>
              </label>
              <label class="contact-field contact-field-wide">
                <span>Cuéntanos un poco más *</span>
                <textarea name="message" rows="4" placeholder="¿Qué proceso te quita más tiempo hoy?" minlength="20" maxlength="2000" aria-describedby="message-error message-count" required></textarea>
                <span class="field-meta"><small class="field-error" id="message-error"></small><small id="message-count">0/2000</small></span>
              </label>
            </div>

            <button class="contact-submit" type="submit">Solicitar evaluación gratuita</button>
            <p class="contact-status" role="status" aria-live="polite"></p>
            <p class="contact-privacy">Usaremos tus datos únicamente para responder esta solicitud. <a href="/privacidad">Consulta nuestra política de privacidad.</a></p>
          </form>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style is:global>
/* Dirección visual inspirada en Stepbro: tipografía expresiva, negro neutro y movimiento mínimo. */
.material-symbols-rounded {
  font-family:'Material Symbols Rounded';
  font-weight:normal;
  font-style:normal;
  font-size:22px;
  line-height:1;
  letter-spacing:normal;
  text-transform:none;
  display:inline-block;
  white-space:nowrap;
  word-wrap:normal;
  direction:ltr;
  -webkit-font-feature-settings:'liga';
  -webkit-font-smoothing:antialiased;
}

#hero {
  min-height:100svh;
  display:block;
  padding:clamp(104px,12vh,132px) max(24px,env(safe-area-inset-right,0px)) clamp(42px,6vh,64px) max(24px,env(safe-area-inset-left,0px));
  text-align:left;
}

#hbg {
  background:
    radial-gradient(circle at 12% 18%,rgba(60,132,246,.18),transparent 34%),
    radial-gradient(circle at 88% 20%,rgba(151,91,255,.11),transparent 32%),
    radial-gradient(circle at 70% 88%,rgba(32,201,178,.08),transparent 30%),
    var(--surface);
}

.hero-layout {
  position:relative;
  z-index:2;
  width:min(100%,1200px);
  min-height:calc(100svh - clamp(146px,18vh,196px));
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(0,1.03fr) minmax(440px,.97fr);
  align-items:center;
  gap:clamp(42px,4vw,72px);
}

.hero-copy { min-width:0; }

.hlabel,
h1,
.hsub,
.hact,
nav.nav-header {
  animation:none !important;
  transform:none !important;
}

.hlabel {
  box-sizing:border-box;
  max-width:100%;
  margin-bottom:28px;
  padding:6px 11px;
  background:rgba(255,255,255,.02);
  border-color:rgba(255,255,255,.1);
  color:rgba(255,255,255,.5);
  font-size:10px;
  letter-spacing:.06em;
  line-height:1.35;
  text-transform:none;
  white-space:normal;
}

.hlabel::before {
  width:6px;
  height:6px;
  box-shadow:none;
  animation:none;
}

h1 {
  max-width:720px;
  font-size:clamp(48px,5.3vw,78px);
  line-height:.98;
  letter-spacing:-.045em;
  text-wrap:balance;
}

.acc { color:var(--white); }

.hsub {
  max-width:600px;
  margin:28px 0 34px;
  font-size:18px;
  line-height:1.58;
  text-wrap:balance;
}

.hact { justify-content:flex-start;margin-top:2px; }

.hero-assurance {
  display:flex;
  flex-wrap:wrap;
  gap:10px 18px;
  margin-top:22px;
  color:var(--muted);
  font-size:12px;
}
.hero-assurance span { display:flex;align-items:center;gap:7px; }
.hero-assurance span::before { content:'✓';color:var(--green);font-weight:700; }

.btn-p,
.btn-g {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  min-height:52px;
  padding:0 25px;
  border-radius:14px;
  font-size:15px;
  line-height:1;
  transition:background-color .18s ease,border-color .18s ease,color .18s ease;
}

.btn-p {
  background:var(--button-bg);
  color:var(--button-text);
  box-shadow:none;
}

.btn-p:hover {
  transform:none;
  filter:brightness(.92);
  box-shadow:none;
}

.hero-copy .btn-g { background:var(--button-bg);border-color:var(--button-bg);color:var(--button-text);box-shadow:0 10px 24px rgba(49,120,238,.2); }
.hero-copy .btn-g:hover { background:var(--button-bg);border-color:var(--button-bg);color:var(--button-text);filter:brightness(.92);box-shadow:0 12px 28px rgba(49,120,238,.28); }
.hero-copy .btn-g:focus-visible { outline:3px solid var(--blue-light);outline-offset:4px;box-shadow:0 0 0 6px rgba(108,167,255,.16),0 10px 24px rgba(49,120,238,.24); }
.hero-whatsapp-icon { display:block;width:19px;height:19px;flex:0 0 auto;fill:currentColor; }

.btn-p:active,
.btn-g:active { transform:scale(.97);transition-duration:100ms; }

.btn-g:hover {
  background:rgba(255,255,255,.06);
  border-color:rgba(255,255,255,.22);
  color:var(--white);
}

.hero-flow {
  position:relative;
  width:100%;
  margin-top:0;
  text-align:left;
}

.flow-stage {
  position:relative;
  aspect-ratio:600 / 490;
  overflow:hidden;
  isolation:isolate;
  border:1px solid rgba(108,167,255,.3);
  border-radius:28px;
  background:linear-gradient(145deg,rgba(18,35,59,.98),rgba(8,19,34,.98));
  box-shadow:0 28px 70px rgba(0,0,0,.34),0 4px 18px rgba(49,120,238,.09);
}

.flow-stage::before {
  content:'';
  position:absolute;
  width:420px;
  aspect-ratio:1;
  top:36px;
  left:50%;
  z-index:-1;
  border-radius:50%;
  transform:translateX(-50%);
  background:repeating-radial-gradient(circle,transparent 0 42px,rgba(108,167,255,.09) 43px 44px,transparent 45px 70px);
}

html:not(.light) .flow-stage::before { display:none; }

.flow-pattern {
  position:absolute;
  top:22px;
  right:24px;
  width:42px;
  height:28px;
  opacity:.3;
  background-image:radial-gradient(circle,#6ca7ff 1px,transparent 1.2px);
  background-size:8px 8px;
}

.flow-lines {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  overflow:visible;
  z-index:0;
}

.flow-signal { fill:none;stroke:#1677ff;stroke-width:3;stroke-linecap:round;stroke-dasharray:140;stroke-dashoffset:140;animation:flowSignal .4s ease forwards; }
.flow-signal-two { animation-delay:.16s; }.flow-signal-three { animation-delay:.32s; }.flow-signal-four { animation-delay:.48s; }
.flow-lines circle { fill:#1677ff;opacity:0;animation:flowNode .16s ease forwards; }
.flow-lines circle:nth-of-type(3),.flow-lines circle:nth-of-type(4) { animation-delay:.16s; }.flow-lines circle:nth-of-type(5),.flow-lines circle:nth-of-type(6) { animation-delay:.32s; }.flow-lines circle:nth-of-type(7),.flow-lines circle:nth-of-type(8) { animation-delay:.48s; }

.flow-card {
  position:absolute;
  z-index:1;
  display:flex;
  flex-direction:column;
  box-sizing:border-box;
  width:22.5%;
  height:22.5%;
  min-height:0;
  padding:17px;
  border:1px solid rgba(108,167,255,.3);
  border-radius:20px;
  background:linear-gradient(145deg,rgba(31,52,82,.98),rgba(15,31,52,.98));
  box-shadow:0 14px 30px rgba(0,0,0,.28),0 2px 8px rgba(49,120,238,.08);
  opacity:0;
  animation:flowCard .34s ease forwards;
}
.flow-card strong { margin-top:auto;font-family:var(--font-h);font-size:16px;line-height:1.1;letter-spacing:-.025em;color:#f4f7fb; }
.flow-card small { display:block;margin-top:7px;color:#a3b3c7;font-size:7.5px;font-weight:800;letter-spacing:.085em;line-height:1.25;text-transform:uppercase; }
.flow-index { color:#1677ff;font-size:10px;font-weight:800;letter-spacing:.1em; }
.flow-icon { position:absolute;top:13px;right:13px;display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:rgba(76,148,255,.17);color:#6ca7ff; }
.flow-icon svg { width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round; }
.flow-request { top:6.3%;left:7.2%;animation-delay:.04s; }
.flow-validation { top:29.4%;left:29%;width:20.5%;animation-delay:.16s; }
.flow-team { top:8%;left:55.4%;width:22.2%;animation-delay:.28s; }
.flow-system { top:58.9%;left:42.8%;width:24.5%;animation-delay:.4s; }
.flow-report { top:57.1%;right:3%;width:21.4%;animation-delay:.52s; }
.flow-report .flow-index,.flow-report .flow-icon { color:var(--green); }
.flow-report .flow-icon { background:rgba(101,214,163,.18); }
.flow-outcome-mark { position:absolute;top:14px;right:13px;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 4px rgba(101,214,163,.14);opacity:0;animation:flowNode .18s ease .7s forwards; }
.flow-caption { position:absolute;right:24px;bottom:20px;left:24px;display:flex;align-items:center;gap:12px;color:#8497af;font-size:8px;font-weight:800;letter-spacing:.1em;line-height:1.2;text-align:center; }
.flow-caption::before,.flow-caption::after { content:'';height:1px;flex:1;background:rgba(115,130,154,.25); }.flow-caption span { flex:0 1 auto; }

@keyframes flowSignal { to { stroke-dashoffset:0; } }
@keyframes flowCard { to { opacity:1;transform:translateY(0); } }
@keyframes flowNode { to { opacity:1; } }
.flow-card { transform:translateY(8px); }
@media(prefers-reduced-motion:reduce) { .flow-card,.flow-signal,.flow-lines circle,.flow-outcome-mark { animation:none;opacity:1;transform:none;stroke-dashoffset:0; } }

.reveal,
