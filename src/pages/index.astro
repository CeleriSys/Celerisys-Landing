---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Celerisys — Software que trabaja mientras tú descansas">
  <!-- ──────── INTRO VOLCANO ──────── -->
  <div id="intro">
    <canvas id="vc"></canvas>
    <div id="ilogo">
      <img src="/logo-1-a.png" alt="Celerisys" class="intro-logo" style="width:110px; height:110px; border-radius:20px; box-shadow: 0 0 40px rgba(107,95,255,.6); object-fit: cover;">
      <div id="iword">Celerisys</div>
      <div id="itag">Software que trabaja mientras tú descansas</div>
    </div>
  </div>

  <!-- ──────── HERO ──────── -->
  <section id="hero">
    <div id="hbg"></div>
    <div class="mountain-bg">
      <svg width="100%" viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" fill="none">
        <polygon points="0,300 380,300 720,55 1060,300 1440,300" fill="rgba(107,95,255,.04)"/>
        <polygon points="180,300 480,300 720,105 960,300 1260,300" fill="rgba(107,95,255,.06)"/>
        <polygon points="675,55 720,22 765,55 748,72 692,72" fill="rgba(255,255,255,.08)"/>
        <polygon points="697,55 720,22 743,55" fill="rgba(255,255,255,.18)"/>
      </svg>
    </div>
    <div class="hlabel">Automatización & Software a medida · Arequipa, Perú</div>
    <h1>¿Cuántas horas al día haces cosas que <span class="acc">una máquina podría hacer</span> por ti?</h1>
    <p class="hsub">En Celerisys construimos el sistema que trabaja mientras tú descansas. Automatizamos, optimizamos y escalamos tu negocio — sin que tú tengas que empujarlo cada día.</p>
    <div class="hact">
      <a href="#booking" class="btn-p">Quiero que mi negocio trabaje solo</a>
      <a href="#what" class="btn-g">Ver cómo lo hacemos</a>
    </div>
  </section>

  <!-- ──────── PAIN POINTS ──────── -->
  <section id="pain">
    <div class="inner">
      <div class="reveal fb" style="text-align:center;">
        <span class="slabel">¿Te suena familiar?</span>
        <h2 class="stitle" style="max-width:100%;text-align:center;">El problema no siempre es donde crees</h2>
        <p class="sbody" style="max-width:600px;margin:12px auto 0;text-align:center;">La mayoría de dueños de negocio creen que el problema es el precio o el mercado.<br>Casi siempre, la fuga real está en otro lugar.</p>
      </div>
      <div class="pain-grid stg reveal fb">
        <div class="pain-card">
          <div class="pain-icon">🔥</div>
          <div class="pain-q">"Trabajo 12 horas al día y sigo sin crecer"</div>
          <div class="pain-a">Cuando el dueño es el cuello de botella, el negocio no puede escalar. Te liberamos de las tareas que frenan tu crecimiento.</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">📉</div>
          <div class="pain-q">"Los números no me cierran y no sé por qué"</div>
          <div class="pain-a">Muchas veces la fuga está en los procesos internos: errores manuales, retrabajos, información dispersa. Lo encontramos y lo tapamos.</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">🔁</div>
          <div class="pain-q">"Mi equipo repite lo mismo todos los días"</div>
          <div class="pain-a">Si hay algo que se repite más de 3 veces a la semana, puede automatizarse. Tu equipo debería estar pensando, no ejecutando tareas mecánicas.</div>
        </div>
        <div class="pain-card">
          <div class="pain-icon">📦</div>
          <div class="pain-q">"Crecemos, pero todo se desordena más"</div>
          <div class="pain-a">Crecer sin sistemas es crecer caótico. Te damos la estructura tecnológica para que cada nuevo cliente o empleado sume, no reste.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── WHAT WE DO ──────── -->
  <section id="what">
    <div class="inner">
      <div class="two">
        <div class="reveal fl">
          <span class="slabel">Qué hacemos</span>
          <h2 class="stitle">No vendemos plantillas.<br>Construimos <span class="acc">tu solución exacta</span></h2>
          <p class="sbody">No somos una agencia de software más. Somos el equipo técnico que tu negocio siempre necesitó y nunca tuvo. Cada sistema que construimos resuelve un problema real y específico de tu operación.</p>
          <a href="#booking" class="btn-p" style="margin-top:28px;">Hablar con el equipo</a>
        </div>
        <div class="service-list stg reveal fr">
          <div class="svc">
            <div class="svc-ico">⚙️</div>
            <div>
              <div class="svc-name">Automatización de procesos</div>
              <div class="svc-desc">Convertimos tareas repetitivas en flujos automáticos. Cotizaciones, facturas, reportes, seguimiento de clientes — todo sin que tu equipo lo toque.</div>
            </div>
          </div>
          <div class="svc">
            <div class="svc-ico">💻</div>
            <div>
              <div class="svc-name">Software hecho para tu negocio</div>
              <div class="svc-desc">Sistemas de gestión, plataformas internas y aplicaciones diseñadas exactamente para cómo opera tu empresa. Sin funciones que no usas, sin límites que te frenan.</div>
            </div>
          </div>
          <div class="svc">
            <div class="svc-ico">📊</div>
            <div>
              <div class="svc-name">Visibilidad total de tu operación</div>
              <div class="svc-desc">Dashboards en tiempo real, alertas automáticas y reportes que te dicen exactamente qué está pasando — sin tener que preguntar a nadie.</div>
            </div>
          </div>
          <div class="svc">
            <div class="svc-ico">🤖</div>
            <div>
              <div class="svc-name">Inteligencia artificial aplicada</div>
              <div class="svc-desc">Chatbots que atienden 24/7, análisis predictivo, clasificación automática de clientes y mucho más. IA que genera resultados reales, no demos bonitas.</div>
            </div>
          </div>
          <div class="svc">
            <div class="svc-ico">🚀</div>
            <div>
              <div class="svc-name">Escalar sin depender de ti</div>
              <div class="svc-desc">Construimos sistemas que crecen solos: más clientes, más ventas, más pedidos — sin que tú tengas que trabajar el doble.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── RESULTS ──────── -->
  <section id="results">
    <div class="inner">
      <div class="reveal fb" style="text-align:center;">
        <span class="slabel">Resultados reales</span>
        <h2 class="stitle" style="max-width:100%;text-align:center;">Números que hablan por sí solos</h2>
      </div>
      <div class="res-grid stg reveal fb">
        <div class="res-card">
          <div class="res-num">−70%</div>
          <div class="res-lbl">Reducción en tareas manuales</div>
        </div>
        <div class="res-card">
          <div class="res-num">3×</div>
          <div class="res-lbl">Velocidad de operación promedio</div>
        </div>
        <div class="res-card">
          <div class="res-num">+50</div>
          <div class="res-lbl">Negocios transformados</div>
        </div>
        <div class="res-card">
          <div class="res-num">Sem.</div>
          <div class="res-lbl">Primeros resultados visibles</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── METHOD ──────── -->
  <section id="method">
    <div class="inner">
      <div class="reveal fb" style="text-align:center;">
        <span class="slabel">Nuestro método</span>
        <h2 class="stitle" style="max-width:100%;text-align:center;">Así trabajamos en Celerisys</h2>
        <p class="sbody" style="max-width:560px;margin:12px auto 0;text-align:center;">Un proceso probado, sin suposiciones y orientado a resultados rápidos. No empezamos a construir hasta entender el problema real.</p>
      </div>
      <div class="steps stg reveal fb">
        <div class="step">
          <div class="snum">01</div>
          <div class="stname">Entendemos tu negocio a fondo</div>
          <div class="stxt">No asumimos nada. Preguntamos todo. Mapeamos cómo fluye tu operación hoy — quién hace qué, dónde se pierde tiempo y dinero, qué frena el crecimiento.</div>
        </div>
        <div class="step">
          <div class="snum">02</div>
          <div class="stname">Identificamos las fugas invisibles</div>
          <div class="stxt">Detectamos los procesos que te están costando dinero sin que te des cuenta: retrabajos, errores manuales, cuellos de botella que parecen normales pero no lo son.</div>
        </div>
        <div class="step">
          <div class="snum">03</div>
          <div class="stname">Construimos la solución exacta</div>
          <div class="stxt">Diseñamos y desarrollamos el sistema hecho para tu caso específico. Sin templates genéricos. Sin funciones que no usas. Solo lo que tu negocio necesita.</div>
        </div>
        <div class="step">
          <div class="snum">04</div>
          <div class="stname">Lo implementamos y lo dejamos corriendo</div>
          <div class="stxt">Capacitamos a tu equipo, ajustamos hasta que todo funcione a la perfección y lo dejamos operando en piloto automático. Tú ves resultados en semanas, no en años.</div>
        </div>
      </div>
      <div class="reveal fb" style="text-align:center;margin-top:48px;">
        <div style="display:inline-block;padding:20px 36px;background:rgba(107,95,255,.08);border:1px solid var(--border);border-radius:12px;max-width:640px;">
          <p style="font-family:var(--font-h);font-size:17px;font-weight:600;margin-bottom:8px;">No somos una agencia de software más.</p>
          <p style="font-size:15px;color:var(--muted);line-height:1.65;">Somos el equipo técnico que tu negocio siempre necesitó y nunca tuvo. La diferencia es que entendemos tu operación antes de escribir una sola línea de código.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── TESTIMONIAL ──────── -->
  <section id="testi">
    <div class="inner">
      <div class="reveal fb" style="text-align:center;">
        <span class="slabel">Caso real</span>
        <h2 class="stitle" style="max-width:100%;text-align:center;">Lo que descubres cuando miras adentro</h2>
      </div>
      <div class="tcard reveal fb">
        <p class="tquote">
          "Pensábamos que el problema era el precio o el mercado, porque los números no nos cerraban.
          Al analizar la operación con Celerisys, descubrimos que la verdadera fuga estaba en el desorden interno.
          En pocas semanas empezamos a recuperar <strong>miles de soles que antes se nos escapaban</strong> sin darnos cuenta."
        </p>
        <div class="tauthor">
          <img class="tauthor-img" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==" id="delypapaAvatar" alt="Delypapa">
          <div>
            <div class="tauthor-name">Equipo Delypapa</div>
            <div class="tauthor-role">Empresa de alimentos · Arequipa, Perú</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── BOOKING / CALENDAR ──────── -->
  <section id="booking">
    <div class="inner">
      <div class="book-wrap">
        <div class="book-left reveal fl">
          <span class="slabel">Agenda tu llamada</span>
          <h2 class="stitle">30 minutos que pueden cambiar tu negocio</h2>
          <p class="sbody">Sin compromiso. Sin tecnicismos. Solo una conversación honesta sobre lo que está frenando tu crecimiento y cómo podemos resolverlo.</p>
          <div class="book-benefits">
            <div class="bben">Analizamos tu operación gratis en la llamada</div>
            <div class="bben">Te decimos exactamente dónde está la fuga</div>
            <div class="bben">Propuesta técnica y económica en 48 horas</div>
            <div class="bben">Primeros resultados visibles en semanas</div>
            <div class="bben">Sin contratos largos ni letras pequeñas</div>
          </div>
          <div style="margin-top:28px;padding:18px 20px;background:rgba(107,95,255,.08);border:1px solid var(--border);border-radius:10px;">
            <div style="font-family:var(--font-h);font-size:13px;font-weight:600;color:var(--blue-light);margin-bottom:6px;">📍 Google Meet · Zona horaria Perú (PET)</div>
            <div style="font-size:13px;color:var(--muted);line-height:1.6;">Reuniones de 1 hora. Elige el día y horario que mejor te convenga en el calendario.</div>
          </div>
        </div>

        <div class="reveal fr">
          <div class="cal-panel">
            <!-- Calendly inline widget begin -->
            <div class="calendly-inline-widget" data-url="https://calendly.com/jefferson-coaquira-tecsup" style="min-width:320px;height:700px;"></div>
            <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
            <!-- Calendly inline widget end -->
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
/* ── INTRO ────────────────────────────────────── */
#intro {
  position:fixed;
  inset:0;
  z-index:9999;
  background:#0F0F23;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  animation:iFade .7s var(--ease) 4.2s forwards;
}

@keyframes iFade {
  to { opacity:0; pointer-events:none; }
}

#vc {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

#ilogo {
  position:relative;
  z-index:2;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:18px;
  animation:iIn 1s var(--ease) .4s both;
}

@keyframes iIn {
  from { opacity:0; transform:translateY(30px) }
  to { opacity:1; transform:none }
}

#iword {
  font-family:var(--font-h);
  font-size:clamp(36px,6vw,80px);
  font-weight:700;
  letter-spacing:-.03em;
  color:#fff;
  text-shadow:0 0 40px rgba(107,95,255,.9);
  animation:iWord 1s var(--ease) 1.3s both;
}

@keyframes iWord {
  from { opacity:0; letter-spacing:.08em }
  to { opacity:1; letter-spacing:-.03em }
}

#itag {
  font-family:var(--font-b);
  font-size:15px;
  color:rgba(185,195,255,.65);
  letter-spacing:.14em;
  text-transform:uppercase;
  animation:iIn 1s var(--ease) 2.1s both;
}

/* ── HERO ────────────────────────────────────── */
#hero {
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  text-align:center;
  padding:120px 40px 80px;
}

#hbg {
  position:absolute;
  inset:0;
  background:
    radial-gradient(ellipse 80% 55% at 50% 115%,rgba(107,95,255,.22) 0%,transparent 65%),
    radial-gradient(ellipse 100% 35% at 50% 100%,rgba(43,78,222,.13) 0%,transparent 60%),
    #0b0d13;
}

.mountain-bg {
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  pointer-events:none;
}

.hlabel {
  position:relative;
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:5px 15px;
  border:1px solid var(--border);
  border-radius:999px;
  font-family:var(--font-h);
  font-size:11px;
  font-weight:600;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--blue-light);
  margin-bottom:26px;
  background:rgba(107,95,255,.08);
  animation:iIn .8s var(--ease) 4.9s both;
}

.hlabel::before {
  content:'';
  width:5px;
  height:5px;
  border-radius:50%;
  background:var(--blue);
  box-shadow:0 0 7px var(--blue);
  animation:blink 2s infinite;
}

@keyframes blink {
  50% { opacity:.25 }
}

h1 {
  position:relative;
  font-family:var(--font-h);
  font-size:clamp(38px,6.5vw,90px);
  font-weight:700;
  line-height:1.04;
  letter-spacing:-.03em;
  max-width:860px;
  animation:iIn .9s var(--ease) 5.1s both;
}

.acc { color:var(--blue); }

.hsub {
  position:relative;
  max-width:540px;
  font-size:18px;
  line-height:1.72;
  color:var(--muted);
  margin:22px 0 38px;
  animation:iIn .9s var(--ease) 5.3s both;
}

.hact {
  position:relative;
  display:flex;
  gap:14px;
  flex-wrap:wrap;
  justify-content:center;
  animation:iIn .8s var(--ease) 5.5s both;
}

/* ── PAIN / HOOK ─────────────────────────────── */
#pain {
  background:rgba(107,95,255,.03);
}

.pain-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:20px;
  margin-top:56px;
}

.pain-card {
  padding:28px 26px;
  background:var(--glass);
  border:1px solid var(--border2);
  border-radius:14px;
  backdrop-filter:blur(18px);
  transition:border-color .3s,transform .3s;
}

.pain-card:hover {
  border-color:var(--blue);
  transform:translateY(-4px);
}

.pain-icon {
  font-size:26px;
  margin-bottom:14px;
}

.pain-q {
  font-family:var(--font-h);
  font-size:16px;
  font-weight:600;
  line-height:1.4;
  margin-bottom:10px;
}

.pain-a {
  font-size:13px;
  color:var(--muted);
  line-height:1.65;
}

/* ── WHAT WE DO ──────────────────────────────── */
#what .two {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:56px;
  align-items:center;
  margin-top:56px;
}

@media(max-width:780px) {
  #what .two { grid-template-columns:1fr; }
}

.service-list {
  display:flex;
  flex-direction:column;
  gap:16px;
}

.svc {
  display:flex;
  align-items:flex-start;
  gap:14px;
  padding:22px 20px;
  background:var(--glass);
  border:1px solid var(--border2);
  border-radius:12px;
  backdrop-filter:blur(16px);
  transition:border-color .3s,transform .3s;
}

.svc:hover {
  border-color:var(--blue);
  transform:translateX(4px);
}

.svc-ico {
  min-width:40px;
  height:40px;
  background:rgba(107,95,255,.14);
  border:1px solid rgba(107,95,255,.28);
  border-radius:9px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
}

.svc-name {
  font-family:var(--font-h);
  font-size:15px;
  font-weight:600;
  margin-bottom:5px;
}

.svc-desc {
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}

/* ── RESULTS / NUMBERS ───────────────────────── */
#results {
  background:radial-gradient(ellipse 60% 60% at 50% 50%,rgba(107,95,255,.07),transparent 70%);
}

.res-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:2px;
  border:1px solid var(--border);
  border-radius:18px;
  overflow:hidden;
  margin-top:56px;
}

.res-card {
  padding:40px 28px;
  background:var(--glass);
  backdrop-filter:blur(18px);
  text-align:center;
}

.res-num {
  font-family:var(--font-h);
  font-size:50px;
  font-weight:700;
  letter-spacing:-.03em;
  background:linear-gradient(135deg,#fff 40%,var(--blue));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  line-height:1;
}

.res-lbl {
  font-size:13px;
  color:var(--muted);
  margin-top:7px;
  font-weight:500;
}

/* ── METHOD ──────────────────────────────────── */
#method {
  background:rgba(107,95,255,.025);
}

.steps {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:0;
  margin-top:56px;
  position:relative;
}

.steps::after {
  content:'';
  position:absolute;
  top:36px;
  left:8%;
  right:8%;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--border),transparent);
}

.step {
  padding:28px 22px;
  position:relative;
  z-index:1;
}

.snum {
  width:44px;
  height:44px;
  background:linear-gradient(135deg,#6B5FFF,#4642D6);
  border-radius:11px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-family:var(--font-h);
  font-size:17px;
  font-weight:700;
  color:#fff;
  margin-bottom:18px;
  box-shadow:0 6px 20px rgba(107,95,255,.35);
}

.stname {
  font-family:var(--font-h);
  font-size:16px;
  font-weight:600;
  margin-bottom:8px;
}

.stxt {
  font-size:13px;
  color:var(--muted);
  line-height:1.62;
}

/* ── TESTIMONIAL ─────────────────────────────── */
#testi {
  background:radial-gradient(ellipse 70% 80% at 50% 50%,rgba(107,95,255,.09),transparent 70%);
}

.tcard {
  max-width:820px;
  margin:56px auto 0;
  padding:48px 44px;
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:22px;
  backdrop-filter:blur(28px);
  position:relative;
  overflow:hidden;
}

.tcard::before {
  content:'';
  position:absolute;
  top:-1px;
  left:20%;
  right:20%;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--blue),transparent);
}

.tquote {
  font-size:clamp(16px,2vw,20px);
  line-height:1.72;
  color:rgba(255,255,255,.88);
  font-style:italic;
  margin-bottom:28px;
}

.tauthor {
  display:flex;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}

.tauthor-img {
  width:72px;
  height:72px;
  border-radius:50%;
  object-fit:cover;
  border:2px solid var(--blue);
}

.tauthor-name {
  font-family:var(--font-h);
  font-size:17px;
  font-weight:700;
}

.tauthor-role {
  font-size:13px;
  color:var(--muted);
  margin-top:3px;
}

/* ── BOOKING CALENDAR ────────────────────────── */
#booking {
  background:radial-gradient(ellipse 60% 70% at 50% 50%,rgba(107,95,255,.1),transparent 70%);
}

.book-wrap {
  display:grid;
  grid-template-columns:1fr 1.4fr;
  gap:40px;
  align-items:start;
  margin-top:56px;
}

@media(max-width:860px) {
  .book-wrap { grid-template-columns:1fr; }
}

.book-left .stitle {
  font-size:clamp(24px,3vw,38px);
}

.book-left .sbody {
  font-size:16px;
}

.book-benefits {
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:28px;
}

.bben {
  display:flex;
  align-items:center;
  gap:10px;
  font-size:14px;
  font-weight:500;
  color:rgba(255,255,255,.8);
}

.bben::before {
  content:'✓';
  width:22px;
  height:22px;
  min-width:22px;
  background:rgba(107,95,255,.2);
  border:1px solid rgba(107,95,255,.4);
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:11px;
  color:var(--blue-light);
  font-weight:700;
}

/* Calendar panel */
.cal-panel {
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:20px;
  backdrop-filter:blur(24px);
  overflow:hidden;
}

.calendly-inline-widget {
  width:100%;
}

.cal-header {
  padding:20px 24px;
  border-bottom:1px solid var(--border2);
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.cal-title {
  font-family:var(--font-h);
  font-size:17px;
  font-weight:600;
}

.cal-nav {
  display:flex;
  gap:4px;
}

.cal-nav button {
  width:32px;
  height:32px;
  background:transparent;
  border:1px solid var(--border);
  border-radius:7px;
  color:var(--white);
  cursor:pointer;
  font-size:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:background .2s,border-color .2s;
}

.cal-nav button:hover {
  background:rgba(107,95,255,.15);
  border-color:var(--blue);
}

.cal-grid-header {
  display:grid;
  grid-template-columns:repeat(7,1fr);
  padding:12px 16px 4px;
  gap:4px;
}

.cal-dname {
  text-align:center;
  font-family:var(--font-h);
  font-size:11px;
  font-weight:600;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted);
  padding:4px 0;
}

.cal-grid {
  display:grid;
  grid-template-columns:repeat(7,1fr);
  padding:4px 16px 16px;
  gap:4px;
}

.cal-day {
  aspect-ratio:1;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:8px;
  font-family:var(--font-h);
  font-size:13px;
  font-weight:500;
  cursor:default;
  color:var(--muted);
  transition:all .2s;
  position:relative;
}

.cal-day.other-month {
  opacity:.25;
}

.cal-day.today {
  color:var(--white);
  border:1px solid var(--border);
}

.cal-day.available {
  cursor:pointer;
  color:var(--white);
}

.cal-day.available:hover {
  background:rgba(107,95,255,.2);
  border:1px solid rgba(107,95,255,.5);
  color:var(--blue-light);
}

.cal-day.selected {
  background:var(--blue);
  color:#fff !important;
  box-shadow:0 4px 18px rgba(107,95,255,.5);
  border:1px solid transparent;
}

.cal-day.available::after {
  content:'';
  position:absolute;
  bottom:3px;
  left:50%;
  transform:translateX(-50%);
  width:4px;
  height:4px;
  border-radius:50%;
  background:var(--blue);
}

.cal-day.selected::after {
  display:none;
}

.cal-day.past {
  opacity:.2;
  cursor:default;
}

/* Time slots */
.time-panel {
  padding:16px 20px 20px;
  border-top:1px solid var(--border2);
}

.time-label {
  font-family:var(--font-h);
  font-size:11px;
  font-weight:600;
  letter-spacing:.12em;
  text-transform:uppercase;
  color:var(--blue-light);
  margin-bottom:12px;
}

.time-group {
  margin-bottom:16px;
}

.time-group-title {
  font-size:11px;
  color:var(--muted);
  font-weight:600;
  letter-spacing:.08em;
  text-transform:uppercase;
  margin-bottom:8px;
}

.time-slots {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.tslot {
  padding:8px 16px;
  border:1px solid var(--border);
  border-radius:7px;
  font-family:var(--font-h);
  font-size:13px;
  font-weight:600;
  color:var(--muted);
  background:transparent;
  cursor:pointer;
  transition:all .2s;
}

.tslot:hover {
  border-color:var(--blue);
  color:var(--blue-light);
  background:rgba(107,95,255,.1);
}

.tslot.sel {
  background:var(--blue);
  border-color:var(--blue);
  color:#fff;
}

.tslot.booked {
  opacity:.3;
  cursor:not-allowed;
}

/* Form below calendar */
.book-form {
  padding:0 20px 20px;
  border-top:1px solid var(--border2);
}

.bf-title {
  font-family:var(--font-h);
  font-size:14px;
  font-weight:600;
  padding:16px 0 12px;
  color:var(--blue-light);
}

.fg {
  display:flex;
  flex-direction:column;
  gap:5px;
  margin-bottom:12px;
}

.fg label {
  font-family:var(--font-h);
  font-size:10px;
  font-weight:600;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--muted);
}

.fg input,
.fg select,
.fg textarea {
  padding:10px 13px;
  background:rgba(0,0,0,.35);
  border:1px solid var(--border2);
  border-radius:7px;
  color:var(--white);
  font-family:var(--font-b);
  font-size:13px;
  outline:none;
  transition:border-color .2s,box-shadow .2s;
  resize:none;
}

.fg input:focus,
.fg select:focus,
.fg textarea:focus {
  border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(107,95,255,.14);
}

.fg select option {
  background:#0b0d13;
}

.fg2 {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

#bk-status {
  text-align:center;
  margin-top:12px;
  font-size:13px;
  min-height:18px;
  font-weight:500;
  color:var(--blue-light);
}
</style>

<script is:inline>
window.addEventListener('DOMContentLoaded', () => {
/* ── VOLCANO INTRO ──────────────────────────────────────── */
(function(){
  const canvas = document.getElementById('vc');
  const ctx = canvas.getContext('2d');
  let W, H, t = 0;
  function resize(){ W = canvas.width = innerWidth; H = canvas.height = innerHeight; }
  resize(); window.addEventListener('resize', resize);

  function rnd(a,b){ return a + Math.random()*(b-a); }

  class Ember {
    constructor(init){
      this.x = W/2 + rnd(-25,25);
      this.y = H*.52;
      this.vx = rnd(-2.8,2.8);
      this.vy = rnd(-13,-4);
      this.life = 1;
      this.decay = rnd(.009,.024);
      this.r = rnd(3,8);
      this.hue = rnd(12,48);
      this.br = rnd(55,80);
      if(init){ this.y = rnd(H*.25,H*.9); this.life = Math.random(); }
    }
    tick(){
      this.x += this.vx*.65; this.vy += .09; this.y += this.vy*.5;
      this.life -= this.decay; this.r *= .994;
      if(this.life <= 0){ Object.assign(this, new Ember(false)); }
    }
    draw(){
      ctx.save(); ctx.globalAlpha = Math.max(0, this.life*.88);
      const g = ctx.createRadialGradient(this.x,this.y,0,this.x,this.y,this.r*2);
      g.addColorStop(0,`hsl(${this.hue},100%,${this.br}%)`);
      g.addColorStop(.5,`hsl(${this.hue},90%,${this.br-22}%)`);
      g.addColorStop(1,'transparent');
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(this.x,this.y,this.r*2,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }
  }
  class Puff {
    constructor(){ this.reset(); }
    reset(){ this.x=W/2+rnd(-35,35); this.y=H*.52; this.vx=rnd(-.7,.7); this.vy=rnd(-1.8,-.4); this.life=1; this.decay=rnd(.003,.007); this.r=rnd(18,55); this.a=rnd(.04,.11); }
    tick(){ this.x+=this.vx; this.y+=this.vy; this.r+=.7; this.life-=this.decay; if(this.life<=0)this.reset(); }
    draw(){ ctx.save(); ctx.globalAlpha=this.life*this.a; ctx.fillStyle='rgb(170,182,215)'; ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2); ctx.fill(); ctx.restore(); }
  }

  const embers = Array.from({length:130},(_,i)=>new Ember(i<80));
  const puffs  = Array.from({length:28},()=>new Puff());
  let stars = null;

  function drawMtn(){
    const mx=W/2, pk=H*.52;
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(0,H);
    ctx.lineTo(mx-W*.38,H); ctx.lineTo(mx-W*.21,H*.73);
    ctx.lineTo(mx-W*.11,H*.63); ctx.lineTo(mx-W*.04,pk+8);
    ctx.lineTo(mx,pk);
    ctx.lineTo(mx+W*.04,pk+8); ctx.lineTo(mx+W*.11,H*.63);
    ctx.lineTo(mx+W*.21,H*.73); ctx.lineTo(mx+W*.38,H);
    ctx.closePath();
    const g=ctx.createLinearGradient(mx,pk,mx,H);
    g.addColorStop(0,'#0c1b3a'); g.addColorStop(.5,'#09112a'); g.addColorStop(1,'#050c1c');
    ctx.fillStyle=g; ctx.fill();
    // snow
    ctx.beginPath();
    ctx.moveTo(mx-38,pk+32); ctx.lineTo(mx-17,pk+4); ctx.lineTo(mx,pk);
    ctx.lineTo(mx+17,pk+4); ctx.lineTo(mx+38,pk+32); ctx.closePath();
    ctx.fillStyle='rgba(195,212,255,.2)'; ctx.fill();
    // vent glow
    const gs=.5+.5*Math.sin(t*.055);
    const gv=ctx.createRadialGradient(mx,pk,0,mx,pk,75);
    gv.addColorStop(0,`rgba(255,130,0,${.48*gs})`); gv.addColorStop(.5,`rgba(255,55,0,${.18*gs})`); gv.addColorStop(1,'transparent');
    ctx.fillStyle=gv; ctx.beginPath(); ctx.arc(mx,pk,75,0,Math.PI*2); ctx.fill();
    ctx.restore();
  }

  function loop(){
    t++;
    ctx.clearRect(0,0,W,H);
    // sky
    const sky=ctx.createLinearGradient(0,0,0,H);
    sky.addColorStop(0,'#000408'); sky.addColorStop(.65,'#010e20'); sky.addColorStop(1,'#061220');
    ctx.fillStyle=sky; ctx.fillRect(0,0,W,H);
    // stars
    if(!stars) stars=Array.from({length:220},()=>({x:Math.random()*W,y:Math.random()*H*.68,r:Math.random()*1.4+.3,a:Math.random()}));
    stars.forEach(s=>{ ctx.globalAlpha=s.a*(.4+.6*Math.sin(t*.025+s.x)); ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.fill(); }); ctx.globalAlpha=1;
    // base glow
    const bg=ctx.createRadialGradient(W/2,H*.72,0,W/2,H*.72,W*.38);
    bg.addColorStop(0,'rgba(107,95,255,.07)'); bg.addColorStop(1,'transparent');
    ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);
    puffs.forEach(p=>{p.tick();p.draw();}); drawMtn(); embers.forEach(e=>{e.tick();e.draw();});
    requestAnimationFrame(loop);
  }
  loop();
})();

/* ── PARTICLES BG ────────────────────────────────────────── */
(function(){
  const c=document.getElementById('particles');
  const ctx=c.getContext('2d');
  let W,H,dots=[];
  function rs(){ W=c.width=innerWidth; H=c.height=innerHeight; }
  rs(); window.addEventListener('resize',rs);
  for(let i=0;i<55;i++) dots.push({x:Math.random()*1e4,y:Math.random()*1e4,vx:(Math.random()-.5)*.28,vy:(Math.random()-.5)*.28,r:Math.random()*1.3+.4});
  function loop(){
    ctx.clearRect(0,0,W,H);
    dots.forEach(d=>{ d.x+=d.vx; d.y+=d.vy; if(d.x<0)d.x=W; if(d.x>W)d.x=0; if(d.y<0)d.y=H; if(d.y>H)d.y=0; ctx.beginPath(); ctx.arc(d.x%W,d.y%H,d.r,0,Math.PI*2); ctx.fillStyle='rgba(107,95,255,.22)'; ctx.fill(); });
    for(let i=0;i<dots.length;i++) for(let j=i+1;j<dots.length;j++){ const dx=(dots[i].x%W)-(dots[j].x%W),dy=(dots[i].y%H)-(dots[j].y%H),dist=Math.sqrt(dx*dx+dy*dy); if(dist<95){ ctx.beginPath(); ctx.moveTo(dots[i].x%W,dots[i].y%H); ctx.lineTo(dots[j].x%W,dots[j].y%H); ctx.strokeStyle=`rgba(107,95,255,${.055*(1-dist/95)})`; ctx.lineWidth=.5; ctx.stroke(); }}
    requestAnimationFrame(loop);
  }
  loop();
})();

/* ── SCROLL REVEAL ────────────────────────────────────────── */
const obs = new IntersectionObserver(entries=>{
  entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('vis'); obs.unobserve(e.target); }});
},{threshold:.1});
document.querySelectorAll('.reveal,.stg').forEach(el=>obs.observe(el));

});
</script>
