---
import Layout from '../layouts/Layout.astro';

const configuredWeb3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const web3formsAccessKey = configuredWeb3FormsKey === 'tu_clave_publica_de_web3forms'
  ? ''
  : configuredWeb3FormsKey;
---

<Layout
  title="Celerisys — Automatización y software a medida en Perú"
  description="Automatizamos procesos y creamos software a medida para que empresas peruanas recuperen tiempo, reduzcan errores y crezcan con una operación más ordenada."
>
  <!-- ──────── HERO ──────── -->
  <section id="hero">
    <div id="hbg"></div>
    <div class="hero-layout">
      <div class="hero-copy">
        <div class="hlabel">Software a medida · Automatización · Arequipa, Perú</div>
        <h1>Webs, sistemas y automatizaciones para tu negocio.</h1>
        <p class="hsub">Diseñamos soluciones digitales claras para vender mejor, ordenar procesos y conectar tus herramientas.</p>
        <div class="hact">
          <a href="#booking" class="btn-p">Solicitar diagnóstico gratuito</a>
          <a href="https://wa.me/51935875743?text=Hola%2C%20vi%20la%20web%20de%20Celerisys%20y%20quisiera%20evaluar%20qu%C3%A9%20procesos%20puedo%20automatizar%20en%20mi%20negocio." class="btn-g" target="_blank" rel="noopener noreferrer" data-conversion="whatsapp-hero">Escribir por WhatsApp</a>
        </div>
        <div class="hero-assurance" aria-label="Ventajas del diagnóstico">
          <span>Evaluación inicial sin costo</span>
          <span>Respuesta en un día hábil</span>
          <span>Sin compromiso</span>
        </div>
      </div>
      <div class="hero-kinetic" aria-label="Web, sistemas a medida y automatización">
        <div class="kinetic-stage" aria-hidden="true">
          <span class="kinetic-orb kinetic-orb-blue"></span>
          <span class="kinetic-orb kinetic-orb-green"></span>
          <span class="kinetic-orb kinetic-orb-violet"></span>
          <div class="kinetic-word kinetic-word-web">WEB</div>
          <div class="kinetic-word kinetic-word-software">SOFTWARE</div>
          <div class="kinetic-word kinetic-word-auto">AUTOMATIZACIÓN</div>
          <div class="kinetic-caption">Diseño · Desarrollo · Integración</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── WHAT WE DO ──────── -->
  <section id="what">
    <div class="inner">
      <div class="two">
        <div class="what-copy reveal fl">
          <span class="slabel">Qué hacemos</span>
          <h2 class="stitle">Creamos soluciones digitales claras, útiles y a medida.</h2>
          <p class="sbody">Entendemos tu problema, definimos la solución correcta y la llevamos a producción con diseño, desarrollo y acompañamiento.</p>
          <a href="#booking" class="btn-p" style="margin-top:28px;">Hablar con el equipo</a>
        </div>
        <div class="service-list stg reveal fr">
          <div class="svc">
            <div>
              <span class="svc-tag">01</span>
              <div class="svc-name">Automatización útil</div>
              <div class="svc-desc">Conectamos tareas repetitivas, formularios, WhatsApp, correos y reportes para ahorrar tiempo real.</div>
            </div>
          </div>
          <div class="svc">
            <div>
              <span class="svc-tag">02</span>
              <div class="svc-name">Sistemas a medida</div>
              <div class="svc-desc">Creamos herramientas internas para ordenar clientes, ventas, operaciones, permisos y seguimiento.</div>
            </div>
          </div>
          <div class="svc">
            <div>
              <span class="svc-tag">03</span>
              <div class="svc-name">Webs que convierten</div>
              <div class="svc-desc">Landing pages y sitios web con mensaje claro, carga rápida y llamados a la acción bien pensados.</div>
            </div>
          </div>
          <div class="svc">
            <div>
              <span class="svc-tag">04</span>
              <div class="svc-name">IA aplicada con criterio</div>
              <div class="svc-desc">Usamos IA cuando mejora atención, clasificación, análisis o productividad. No por moda.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── RESULTS ──────── -->
  <section id="results">
    <div class="inner">
      <div class="section-heading split-heading reveal fb">
        <div>
          <span class="slabel">Resultados</span>
          <h2 class="stitle">Menos tareas.<br>Más negocio.</h2>
        </div>
        <p class="sbody">Medimos el impacto en problemas concretos: menos reprocesos, respuestas más rápidas y mejor visibilidad para tomar decisiones.</p>
      </div>
      <div class="results-bento stg reveal fb">
        <article class="result-feature">
          <span class="result-kicker">Impacto observado</span>
          <div class="res-num">−70%</div>
          <div class="res-lbl">Menos tareas repetitivas</div>
          <div class="result-meter" aria-hidden="true"><span></span></div>
          <p>El equipo deja de copiar datos entre archivos, perseguir confirmaciones y corregir información duplicada. El resultado exacto depende de cada operación.</p>
        </article>
        <article class="res-card result-speed">
          <span class="result-kicker">Velocidad</span>
          <div class="res-num">3×</div>
          <div class="res-lbl">Respuesta operativa más rápida</div>
          <span class="result-note">Menos esperas entre áreas</span>
        </article>
        <article class="res-card result-businesses">
          <span class="result-kicker">Experiencia</span>
          <div class="res-num">+4</div>
          <div class="res-lbl">Negocios transformados</div>
          <span class="result-note">Soluciones ajustadas a cada negocio</span>
        </article>
        <article class="result-story reveal fb">
          <div class="story-mark">“</div>
          <p class="tquote">Celerisys encontró la fuga en nuestra operación. En pocas semanas empezamos a recuperar miles de soles que antes se escapaban sin darnos cuenta.</p>
          <div class="tauthor">
            <img class="tauthor-img" src="/delypapalogo-optimized.png" width="256" height="256" loading="lazy" alt="Logo de Delypapa">
            <div>
              <div class="tauthor-name">Delypapa</div>
              <div class="tauthor-role">Empresa de alimentos · Arequipa, Perú</div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ──────── METHOD ──────── -->
  <section id="method">
    <div class="inner">
      <div class="method-layout">
        <div class="method-intro reveal fl">
          <span class="slabel">Método</span>
          <h2 class="stitle">De problema invisible a sistema funcionando.</h2>
          <p class="sbody">Trabajamos por etapas para entender el problema, priorizar bien y entregar una primera versión útil sin inflar el proyecto.</p>
        </div>
        <div class="method-path stg reveal fr">
          <article class="method-step">
            <div class="method-index">01</div>
            <div><h3>Entendemos cómo trabajas hoy</h3><p>Mapeamos tareas, responsables, archivos y puntos donde la información se corta.</p></div>
          </article>
          <article class="method-step">
            <div class="method-index">02</div>
            <div><h3>Elegimos el primer problema correcto</h3><p>Definimos qué conviene resolver primero para generar impacto sin frenar tu operación.</p></div>
          </article>
          <article class="method-step">
            <div class="method-index">03</div>
            <div><h3>Creamos y validamos contigo</h3><p>Desarrollamos por partes pequeñas para que puedas probar, corregir y aprobar con evidencia.</p></div>
          </article>
          <article class="method-step">
            <div class="method-index">04</div>
            <div><h3>Lo llevamos al trabajo real</h3><p>Implementamos, capacitamos y acompañamos los primeros usos para ajustar lo que haga falta.</p></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── FAQ ──────── -->
  <section id="faq">
    <div class="inner">
      <div class="faq-layout">
        <div class="faq-intro reveal fl">
          <span class="slabel">Preguntas frecuentes</span>
          <h2 class="stitle">Lo que necesitas saber antes de empezar.</h2>
          <p class="sbody">No necesitas llegar con una solución definida. Empezamos entendiendo el problema y te recomendamos el siguiente paso más conveniente.</p>
          <a href="#booking" class="btn-p">Cuéntanos tu caso</a>
        </div>
        <div class="faq-list reveal fr">
          <details>
            <summary>¿Cuánto cuesta desarrollar una solución?</summary>
            <p>Depende del proceso, las integraciones y el alcance. Después del diagnóstico inicial recibirás una propuesta clara por etapas, sin costos ocultos.</p>
          </details>
          <details>
            <summary>¿Cuánto tiempo demora?</summary>
            <p>Priorizamos una primera entrega útil y luego avanzamos por etapas. El plazo se define contigo después de mapear el proceso y sus riesgos.</p>
          </details>
          <details>
            <summary>¿Pueden trabajar con los sistemas que ya usamos?</summary>
            <p>Sí. Evaluamos tus herramientas actuales y, cuando es viable, las conectamos para evitar duplicar información o reemplazar todo de golpe.</p>
          </details>
          <details>
            <summary>¿Necesito saber exactamente qué software quiero?</summary>
            <p>No. Puedes empezar contándonos qué tarea consume tiempo, dónde ocurren errores o qué información hoy no puedes ver a tiempo.</p>
          </details>
          <details>
            <summary>¿Incluyen capacitación y soporte?</summary>
            <p>Sí. La puesta en marcha contempla acompañamiento y capacitación. El soporte posterior se define según las necesidades de cada solución.</p>
          </details>
          <details>
            <summary>¿Trabajan fuera de Arequipa?</summary>
            <p>Sí. Atendemos empresas de otras ciudades de Perú de forma remota y coordinamos cada etapa con seguimiento claro.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────── BOOKING / CALENDAR ──────── -->
  <section id="booking">
    <div class="inner">
      <div class="book-wrap">
        <div class="book-left reveal fl">
          <span class="slabel">Contacto</span>
          <h2 class="stitle">Cuéntanos qué quieres mejorar.</h2>
          <p class="sbody">Explícanos brevemente tu operación y te responderemos con el siguiente paso más conveniente. Completarlo toma menos de dos minutos.</p>
          <div class="book-benefits">
            <div class="bben">Primera evaluación sin costo</div>
            <div class="bben">Respuesta personal, no automática</div>
            <div class="bben">Sin compromiso ni llamadas innecesarias</div>
          </div>
          <div class="book-meta-box">
            <div class="book-meta-label"><span class="material-symbols-rounded" aria-hidden="true">mail</span> Respuesta directa por correo</div>
            <div class="book-meta-text">Revisamos cada solicitud y normalmente respondemos dentro de un día hábil.</div>
          </div>
        </div>

        <div class="reveal fr">
          <form id="contact-form" class="contact-panel" action="https://api.web3forms.com/submit" method="POST" novalidate>
            <input type="hidden" name="access_key" value={web3formsAccessKey}>
            <input type="hidden" name="subject" value="Nueva solicitud desde Celerisys">
            <input type="hidden" name="from_name" value="Web Celerisys">
            <input type="hidden" name="utm_source" value="">
            <input type="hidden" name="utm_medium" value="">
            <input type="hidden" name="utm_campaign" value="">
            <input type="hidden" name="utm_content" value="">
            <input type="hidden" name="landing_page" value="">
            <input class="contact-honeypot" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off">

            <div class="contact-form-head">
              <span>Hablemos de tu operación</span>
              <small>Todos los campos marcados son necesarios.</small>
            </div>

            <div class="contact-grid">
              <label class="contact-field">
                <span>Nombre *</span>
                <input type="text" name="name" autocomplete="name" placeholder="Tu nombre" required>
              </label>
              <label class="contact-field">
                <span>Empresa (opcional)</span>
                <input type="text" name="company" autocomplete="organization" placeholder="Nombre de tu negocio">
              </label>
              <label class="contact-field">
                <span>Correo *</span>
                <input type="email" name="email" autocomplete="email" placeholder="nombre@empresa.com" required>
              </label>
              <label class="contact-field">
                <span>WhatsApp (opcional)</span>
                <input type="tel" name="phone" autocomplete="tel" placeholder="+51 999 999 999">
              </label>
              <label class="contact-field contact-field-wide">
                <span>¿Qué te gustaría mejorar? (opcional)</span>
                <span class="select-shell">
                  <span class="material-symbols-rounded select-leading" aria-hidden="true">tune</span>
                  <select name="priority" aria-label="Selecciona qué te gustaría mejorar">
                    <option value="" selected>Selecciona el principal reto de tu operación</option>
                    <option value="Automatizar tareas repetitivas">Automatizar tareas repetitivas</option>
                    <option value="Ordenar información y reportes">Ordenar información y reportes</option>
                    <option value="Crear software a medida">Crear software a medida</option>
                    <option value="Aplicar inteligencia artificial">Aplicar inteligencia artificial</option>
                    <option value="Aún no estoy seguro">Aún no estoy seguro</option>
                  </select>
                  <span class="material-symbols-rounded select-chevron" aria-hidden="true">expand_more</span>
                </span>
              </label>
              <label class="contact-field contact-field-wide">
                <span>Cuéntanos un poco más *</span>
                <textarea name="message" rows="4" placeholder="¿Qué proceso te quita más tiempo hoy?" required></textarea>
              </label>
            </div>

            <button class="contact-submit" type="submit">Solicitar evaluación gratuita</button>
            <p class="contact-status" role="status" aria-live="polite"></p>
            <p class="contact-privacy">Usaremos tus datos únicamente para responder esta solicitud. <a href="/privacidad">Consulta nuestra política de privacidad.</a></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <a
    class="whatsapp-float"
    href="https://wa.me/51935875743?text=Hola%2C%20vi%20la%20web%20de%20Celerisys%20y%20quisiera%20evaluar%20qu%C3%A9%20procesos%20puedo%20automatizar%20en%20mi%20negocio."
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Conversar con Celerisys por WhatsApp"
    data-conversion="whatsapp-float"
  >
    <svg class="whatsapp-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.57-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.894 9.888-9.894 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.9 6.989c-.002 5.45-4.437 9.893-9.892 9.893m8.413-18.297A11.815 11.815 0 0 0 12.055 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.689 1.448h.005c6.558 0 11.894-5.335 11.897-11.893a11.821 11.821 0 0 0-3.488-8.413Z"/>
    </svg>
    WhatsApp
  </a>
</Layout>

<style is:global>
/* Dirección visual inspirada en Stepbro: tipografía expresiva, negro neutro y movimiento mínimo. */
.material-symbols-rounded {
  font-family:'Material Symbols Rounded';
  font-weight:normal;
  font-style:normal;
  font-size:22px;
  line-height:1;
  letter-spacing:normal;
  text-transform:none;
  display:inline-block;
  white-space:nowrap;
  word-wrap:normal;
  direction:ltr;
  -webkit-font-feature-settings:'liga';
  -webkit-font-smoothing:antialiased;
}

#hero {
  min-height:100svh;
  display:block;
  padding:clamp(104px,12vh,132px) max(24px,env(safe-area-inset-right,0px)) clamp(42px,6vh,64px) max(24px,env(safe-area-inset-left,0px));
  text-align:left;
}

#hbg {
  background:
    radial-gradient(circle at 12% 18%,rgba(60,132,246,.18),transparent 34%),
    radial-gradient(circle at 88% 20%,rgba(151,91,255,.11),transparent 32%),
    radial-gradient(circle at 70% 88%,rgba(32,201,178,.08),transparent 30%),
    var(--surface);
}

.hero-layout {
  position:relative;
  z-index:2;
  width:min(100%,1240px);
  min-height:calc(100svh - clamp(146px,18vh,196px));
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);
  align-items:center;
  gap:clamp(42px,6vw,88px);
}

.hero-copy { min-width:0; }

.hlabel,
h1,
.hsub,
.hact,
nav.nav-header {
  animation:none !important;
  transform:none !important;
}

.hlabel {
  margin-bottom:22px;
  padding:7px 13px;
  background:rgba(255,255,255,.035);
  border-color:var(--border2);
  color:var(--muted);
  letter-spacing:.07em;
  text-transform:none;
}

.hlabel::before {
  width:6px;
  height:6px;
  box-shadow:none;
  animation:none;
}

h1 {
  max-width:720px;
  font-size:clamp(48px,5.3vw,78px);
  line-height:.98;
  letter-spacing:-.045em;
  text-wrap:balance;
}

.acc { color:var(--white); }

.hsub {
  max-width:600px;
  margin:24px 0 30px;
  font-size:18px;
  line-height:1.58;
  text-wrap:balance;
}

.hact { justify-content:flex-start; }

.hero-assurance {
  display:flex;
  flex-wrap:wrap;
  gap:10px 18px;
  margin-top:22px;
  color:var(--muted);
  font-size:12px;
}
.hero-assurance span { display:flex;align-items:center;gap:7px; }
.hero-assurance span::before { content:'✓';color:var(--green);font-weight:700; }

.btn-p,
.btn-g {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:52px;
  padding:0 25px;
  border-radius:999px;
  font-size:15px;
  transition:background-color .18s ease,border-color .18s ease,color .18s ease;
}

.btn-p {
  background:var(--button-bg);
  color:var(--button-text);
  box-shadow:none;
}

.btn-p:hover {
  transform:none;
  filter:brightness(.92);
  box-shadow:none;
}

.btn-p:active,
.btn-g:active { transform:scale(.97);transition-duration:100ms; }

.btn-g:hover {
  background:rgba(255,255,255,.06);
  border-color:rgba(255,255,255,.22);
  color:var(--white);
}

.hero-kinetic {
  position:relative;
  width:100%;
  margin-top:0;
  min-height:430px;
  text-align:left;
}

.kinetic-stage {
  position:relative;
  min-height:430px;
  overflow:hidden;
  isolation:isolate;
}

.kinetic-stage::after {
  content:'';
  position:absolute;
  inset:12% 4% 10% 10%;
  z-index:-2;
  background:radial-gradient(ellipse at center,rgba(69,133,255,.13),transparent 68%);
  filter:blur(8px);
}

.kinetic-word {
  position:absolute;
  z-index:2;
  font-weight:900;
  line-height:.82;
  letter-spacing:-.075em;
  white-space:nowrap;
  will-change:transform;
}

.kinetic-word-web {
  top:56px;
  left:4px;
  font-size:clamp(78px,8.6vw,124px);
  color:#fff;
  animation:kineticDrift 7s ease-in-out infinite;
}

.kinetic-word-software {
  top:166px;
  right:2px;
  font-size:clamp(58px,6.4vw,92px);
  color:transparent;
  -webkit-text-stroke:1.5px rgba(151,190,255,.78);
  animation:kineticDrift 8s ease-in-out -2s infinite reverse;
}

.kinetic-word-auto {
  left:28px;
  bottom:82px;
  font-size:clamp(39px,4.4vw,64px);
  background:linear-gradient(90deg,#65d6a3,#a5efce 60%,#6ca7ff);
  background-clip:text;
  -webkit-background-clip:text;
  color:transparent;
  animation:kineticDrift 9s ease-in-out -4s infinite;
}

.kinetic-caption {
  position:absolute;
  right:8px;
  bottom:25px;
  color:rgba(255,255,255,.48);
  font-size:11px;
  font-weight:700;
  letter-spacing:.14em;
  text-transform:uppercase;
}

.kinetic-orb {
  position:absolute;
  z-index:-1;
  border-radius:50%;
  filter:blur(2px);
  opacity:.72;
  animation:orbDrift 9s ease-in-out infinite;
}

.kinetic-orb-blue { width:190px;height:190px;right:30px;top:26px;background:rgba(65,119,255,.22); }
.kinetic-orb-green { width:110px;height:110px;left:18px;bottom:24px;background:rgba(101,214,163,.2);animation-delay:-3s; }
.kinetic-orb-violet { width:70px;height:70px;right:42px;bottom:58px;background:rgba(151,91,255,.28);animation-delay:-6s; }

@keyframes kineticDrift { 0%,100% { transform:translate3d(0,0,0); } 50% { transform:translate3d(10px,-7px,0); } }
@keyframes orbDrift { 0%,100% { transform:translate3d(0,0,0) scale(1); } 50% { transform:translate3d(-12px,10px,0) scale(1.08); } }

.reveal,
.reveal.fl,
.reveal.fr,
.reveal.fb,
.stg>*,
.stg.vis>* {
  opacity:1 !important;
  transform:none !important;
  transition:none !important;
}

#results {
  background:
    radial-gradient(circle at 92% 50%,rgba(151,91,255,.08),transparent 32%),
    var(--surface2);
}

#what,#method,#faq,#booking {
  background:linear-gradient(145deg,var(--surface) 0%,var(--surface2) 145%);
}

#what .inner,
#results .inner,
#method .inner,
#faq .inner,
#booking .inner {
  min-height:auto;
  display:block;
