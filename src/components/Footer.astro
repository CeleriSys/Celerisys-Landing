---
const year = new Date().getFullYear();
---

<footer class="footer-new">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="nlogo" href="#top">
        <img src="/svg/c.svg" alt="Celerisys" class="logo-icon">
        Celerisys
      </a>
      <p>Software a medida y automatización para que tu operación avance sin depender de tareas manuales.</p>
    </div>

    <nav class="footer-nav" aria-labelledby="footer-nav-heading">
      <span class="footer-block-title" id="footer-nav-heading">Enlaces</span>
      <a href="#what">Qué hacemos</a>
      <a href="#results">Resultados</a>
      <a href="#method">Método</a>
      <a href="#booking">Contacto</a>
    </nav>

    <section class="footer-contact" aria-labelledby="footer-contact-heading">
      <h2 class="footer-block-title" id="footer-contact-heading">Contacto y redes</h2>
      <ul class="footer-contact-list">
        <li>
          <a
            class="footer-contact-link"
            href="https://www.instagram.com/celerisys/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="footer-contact-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
              </svg>
            </span>
            <span class="footer-contact-label">Instagram</span>
          </a>
        </li>
        <li>
          <a
            class="footer-contact-link"
            href="https://www.tiktok.com/@celerisys"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="footer-contact-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.17-3.63-5.46-.02-.5-.01-1-.01-1.49H8c0 2.57-.01 5.13 0 7.7.02 1.13.42 2.24 1.14 3.11 1.26 1.53 3.25 2.39 5.21 2.38 2.08.02 4.14-.82 5.52-2.35 1.09-1.22 1.68-2.8 1.62-4.39V7.35c-1.57.24-3.17.36-4.76.29-1.48-.07-2.94-.47-4.24-1.11v-.02z"/>
              </svg>
            </span>
            <span class="footer-contact-label">TikTok</span>
          </a>
        </li>
        <li>
          <a class="footer-contact-link" href="mailto:celerisys@outlook.com">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 6h16v12H4V6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="footer-contact-label">celerisys@outlook.com</span>
          </a>
        </li>
        <li>
          <a class="footer-contact-link" href="tel:+51935875743">
            <span class="footer-contact-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V21a1 1 0 0 1-1 1C10.07 22 2 13.93 2 3a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.2 2.2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="footer-contact-label">+51 935 875 743</span>
          </a>
        </li>
      </ul>
    </section>

    <div class="footer-cta">
      <span class="footer-block-title footer-block-title--muted" id="footer-cta-heading">Ubicación</span>
      <span class="footer-location" aria-labelledby="footer-cta-heading">Arequipa, Perú</span>
      <a class="footer-button" href="#booking">Hablar con el equipo</a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} Celerisys. Todos los derechos reservados.</span>
    <span>Software que trabaja mientras tú descansas.</span>
  </div>
</footer>

<style>
.footer-new {
  position:relative;
  z-index:1;
  border-top:1px solid var(--border2);
  background:var(--surface2);
  padding:56px max(40px, env(safe-area-inset-right)) 28px max(40px, env(safe-area-inset-left));
  padding-left:max(40px, env(safe-area-inset-left, 0px));
  padding-right:max(40px, env(safe-area-inset-right, 0px));
}

.footer-inner {
  max-width:1180px;
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(220px, 1.35fr) minmax(120px, .72fr) minmax(220px, 1.1fr) minmax(180px, .85fr);
  gap:32px 28px;
  align-items:start;
}

.footer-block-title {
  display:block;
  font-family:var(--font-h);
  font-size:11px;
  font-weight:600;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--blue);
  margin-bottom:14px;
}

.footer-block-title--muted {
  color:var(--muted);
  letter-spacing:.12em;
}

.footer-brand {
  max-width:420px;
}

.nlogo {
  display:inline-flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  font-family:var(--font-h);
  font-weight:700;
  font-size:20px;
  color:var(--white);
  transition:color 0.3s ease;
}

.logo-icon {
  width:28px;
  height:28px;
  flex:0 0 auto;
  filter:brightness(0) invert(1);
  transition:filter 0.3s ease;
}

html.light .logo-icon {
  filter:brightness(1) invert(0);
}

.footer-brand p {
  margin-top:14px;
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
}

.footer-nav {
  display:flex;
  flex-direction:column;
  gap:12px;
}

.footer-nav .footer-block-title {
  margin-bottom:2px;
}

.footer-nav a,
.footer-location {
  color:var(--muted);
  font-size:13px;
  line-height:1.45;
}

.footer-nav a {
  text-decoration:none;
  transition:color .2s ease, transform .2s ease;
}

.footer-nav a:hover {
  color:var(--blue-light);
  transform:translateX(3px);
}

.footer-contact {
  min-width:0;
}

.footer-contact .footer-block-title {
  margin-bottom:12px;
}

.footer-contact-list {
  list-style:none;
  margin:0;
  padding:0;
  display:flex;
  flex-direction:column;
  gap:6px;
}

.footer-contact-link {
  display:flex;
  align-items:center;
  gap:12px;
  padding:10px 12px;
  margin:0 -12px;
  border-radius:10px;
  text-decoration:none;
  color:var(--muted);
  font-size:13px;
  font-weight:500;
  line-height:1.35;
  transition:
    color .2s ease,
    background-color .2s ease,
    transform .2s ease,
    border-color .2s ease;
  border:1px solid transparent;
}

.footer-contact-link:hover {
  color:var(--blue-light);
  background:rgba(14,90,156,.1);
  border-color:rgba(14,90,156,.22);
}

.footer-contact-link:focus-visible {
  outline:2px solid var(--blue);
  outline-offset:2px;
}

.footer-contact-icon {
  flex-shrink:0;
  width:38px;
  height:38px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:9px;
  background:rgba(14,90,156,.12);
  border:1px solid rgba(14,90,156,.28);
  color:var(--blue-light);
  transition:
    background .2s ease,
    border-color .2s ease,
    color .2s ease,
    transform .2s ease;
}

.footer-contact-link:hover .footer-contact-icon {
  background:rgba(14,90,156,.2);
  border-color:rgba(14,90,156,.45);
  color:var(--blue-light);
  transform:scale(1.03);
}

html.light .footer-contact-icon {
  background:rgba(14,90,156,.08);
  border-color:rgba(14,90,156,.18);
  color:var(--blue);
}

.footer-contact-label {
  overflow-wrap:anywhere;
  word-break:break-word;
}

.footer-cta {
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:12px;
}

.footer-location {
  margin-top:-4px;
}

.footer-button {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:40px;
  padding:0 18px;
  border-radius:8px;
  background:var(--button-bg);
  color:var(--button-text);
  font-family:var(--font-h);
  font-size:13px;
  font-weight:600;
  text-decoration:none;
  box-shadow:none;
  transition:background-color .18s ease;
}

.footer-button:hover {
  transform:none;
  filter:brightness(.92);
}

.footer-button:focus-visible {
  outline:2px solid var(--blue-light);
  outline-offset:3px;
}

.footer-bottom {
  max-width:1180px;
  margin:36px auto 0;
  padding-top:22px;
  border-top:1px solid var(--border2);
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  flex-wrap:wrap;
  gap:16px;
  color:var(--muted);
  font-size:12px;
  line-height:1.5;
}

html.light .footer-new {
  background:var(--surface2);
}

@media(max-width:1279px) {
  .footer-inner {
    gap:28px 22px;
  }
}

/* lg: brand full width, three columns below */
@media(max-width:1023px) {
  .footer-new {
    padding-top:48px;
    padding-bottom:26px;
    padding-left:max(24px, env(safe-area-inset-left, 0px));
    padding-right:max(24px, env(safe-area-inset-right, 0px));
  }

  .footer-inner {
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:28px 24px;
  }

  .footer-brand {
    grid-column:1 / -1;
    max-width:560px;
  }

  .footer-nav {
    grid-column:auto;
  }

  .footer-contact {
    grid-column:auto;
  }

  .footer-cta {
    grid-column:auto;
  }

  .footer-bottom {
    flex-direction:column;
    align-items:flex-start;
    gap:12px;
  }
}

/* md: single column stack */
@media(max-width:767px) {
  .footer-inner {
    grid-template-columns:1fr;
    gap:28px;
  }

  .footer-brand {
    grid-column:auto;
  }

  .footer-nav {
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:10px 20px;
    align-content:start;
  }

  .footer-nav .footer-block-title {
    grid-column:1 / -1;
    margin-bottom:4px;
  }

  .footer-contact-list {
    gap:4px;
  }

  .footer-contact-link {
    padding:12px 14px;
    margin:0;
  }
}

/* sm */
@media(max-width:639px) {
  .footer-new {
    padding-top:40px;
    padding-bottom:22px;
    padding-left:max(18px, env(safe-area-inset-left, 0px));
    padding-right:max(18px, env(safe-area-inset-right, 0px));
  }

  .footer-inner {
    gap:26px;
  }

  .footer-nav {
    grid-template-columns:1fr;
    gap:12px;
  }

  .footer-cta .footer-button {
    width:100%;
    max-width:320px;
  }
}

@media(hover:none) {
  .footer-nav a:hover {
    transform:none;
  }

  .footer-contact-link:active {
    background:rgba(14,90,156,.14);
  }
}
</style>
