<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const contactStatus = contactForm?.querySelector('.contact-status');
  const contactButton = contactForm?.querySelector('.contact-submit');
  const prioritySelect = contactForm?.querySelector('[name="priority"]');
  const priorityShell = prioritySelect?.closest('.select-shell');

  const updatePriorityStyle = () => {
    if (prioritySelect instanceof HTMLSelectElement) {
      priorityShell?.classList.toggle('has-value', Boolean(prioritySelect.value));
    }
  };

  prioritySelect?.addEventListener('change', updatePriorityStyle);
  updatePriorityStyle();

  if (contactForm) {
    const query = new URLSearchParams(window.location.search);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((name) => {
      const field = contactForm.querySelector(`[name="${name}"]`);
      if (field instanceof HTMLInputElement) field.value = query.get(name) || '';
    });
    const landingPage = contactForm.querySelector('[name="landing_page"]');
    if (landingPage instanceof HTMLInputElement) landingPage.value = window.location.href;
  }

  document.querySelectorAll('[data-conversion]').forEach((link) => {
    link.addEventListener('click', () => {
      if (!(link instanceof HTMLElement)) return;
      window.dispatchEvent(new CustomEvent('celerisys:conversion', {
        detail: { action: link.dataset.conversion }
      }));
    });
  });

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    contactStatus?.classList.remove('is-error', 'is-success');

    if (!contactForm.checkValidity()) {
      contactForm.reportValidity();
      return;
    }

    const accessKey = contactForm.querySelector('[name="access_key"]')?.value;
    if (!accessKey) {
      contactStatus.textContent = 'Falta conectar el correo receptor de Web3Forms.';
      contactStatus.classList.add('is-error');
      return;
    }

    contactButton.disabled = true;
    contactButton.textContent = 'Enviando…';
    contactStatus.textContent = '';

    try {
      const response = await fetch(contactForm.action, {
        method: 'POST',
        body: new FormData(contactForm),
        headers: { Accept: 'application/json' }
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message || 'No se pudo enviar');

      contactForm.reset();
      updatePriorityStyle();
      contactStatus.innerHTML = 'Solicitud enviada. Te responderemos en un día hábil. <a href="https://wa.me/51935875743" target="_blank" rel="noopener noreferrer">También puedes escribirnos por WhatsApp.</a>';
      contactStatus.classList.add('is-success');
      window.dispatchEvent(new CustomEvent('celerisys:conversion', {
        detail: { action: 'contact-form-success' }
      }));
    } catch (error) {
      contactStatus.textContent = 'No pudimos enviar la solicitud. Inténtalo nuevamente.';
      contactStatus.classList.add('is-error');
    } finally {
      contactButton.disabled = false;
      contactButton.textContent = 'Solicitar evaluación gratuita';
    }
  });
</script>
